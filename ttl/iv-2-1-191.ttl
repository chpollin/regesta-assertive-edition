# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1153-00-00_1_0_4_2_1_191_191

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22818> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 191" .

<urn:regesta:actor:RI004-002-S001049:community> a crm:E74_Group ;
    rdfs:label "seiner Mönche" .

<urn:regesta:actor:22818:local:heinrich-von-salm> a crm:E21_Person ;
    rdfs:label "Grafen Heinrich von Salm" .

# The complaints of the monks against the count. The regest names no forum and no outcome;
# Wibald's return on command is movement and stays out of scope.
<urn:regesta:22818:complaint-monks-salm> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22818> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "der Klagen seiner Mönche über den Grafen Heinrich von Salm" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-S001049:community> ;
        rf:role rv:Claimant ;
        rf:nameInSource "seiner Mönche" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:22818:local:heinrich-von-salm> ;
        rf:role rv:Respondent ;
        rf:nameInSource "Grafen Heinrich von Salm" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-47> ;
    rf:verificationStatus rv:unchecked .
