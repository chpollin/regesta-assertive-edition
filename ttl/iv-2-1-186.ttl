<urn:regesta:record:22813> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-R000054> a crm:E21_Person ; rdfs:label "Erzbischof Raimund von Arles" .
<urn:regesta:actor:RI004-002-L000818> a crm:E21_Person ; rdfs:label "Ludwigs (des Blinden)" .
<urn:regesta:actor:RI004-002-M000298> a crm:E21_Person ; rdfs:label "Erzbischof Manasse" .

<urn:regesta:22813:city-arles> a crm:E53_Place ; rdfs:label "die Stadt Arles" .
<urn:regesta:22813:right-regalien> a crm:E30_Right ; crm:P2_has_type rv:LordshipRights ; rdfs:label "die Regalien des Erzbistums" .
<urn:regesta:22813:right-zoelle> a crm:E30_Right ; crm:P2_has_type rv:Toll ; rdfs:label "Zölle" .
<urn:regesta:22813:right-weggelder> a crm:E30_Right ; crm:P2_has_type rv:Toll ; rdfs:label "Weggelder" .
<urn:regesta:22813:right-gerichtsbarkeit> a crm:E30_Right ; crm:P2_has_type rv:Jurisdiction ; rdfs:label "Gerichtsbarkeitsrechte" .
<urn:regesta:22813:thing-hafenanlagen> a crm:E18_Physical_Thing ; rdfs:label "die Hafenanlagen sowohl der Griechen als auch anderer Völker" .
<urn:regesta:22813:right-wasser-weide-crau> a crm:E30_Right ; crm:P2_has_type rv:UsageRights ; rdfs:label "alle Wasser- und Weiderechte auf der Plaine de la Crau" .
<urn:regesta:22813:thing-kastell-fos> a crm:E18_Physical_Thing ; rdfs:label "Fos-sur-Mer (Fossis)" .
<urn:regesta:22813:thing-kastell-albaron> a crm:E18_Physical_Thing ; rdfs:label "Albaron" .
<urn:regesta:22813:thing-kastell-vernegues> a crm:E18_Physical_Thing ; rdfs:label "Vernègues (Aluernis)" .
<urn:regesta:22813:thing-kastell-alleins> a crm:E18_Physical_Thing ; rdfs:label "Alleins (Aualone)" .
<urn:regesta:22813:thing-kastell-mondragon> a crm:E18_Physical_Thing ; rdfs:label "Mondragon (Monte Draconis)" .
