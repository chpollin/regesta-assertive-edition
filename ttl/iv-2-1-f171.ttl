<urn:regesta:22798:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22798> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich bestätigt dem Abt und Grafen Anselm von Bobbio auf seine Bitten und die Intervention des Erzbischofs, obersten Rates und Erzkanzlers Heinrich von Mainz, des Erzbischofs Arnold von Köln, des Bischofs Ortlieb von Basel, des Markgrafen Hermann von Baden und des Grafen Ulrich von Lenzburg" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "die Grafschaft Bobbio innerhalb der angegebenen Grenzen mit allen Rechten und Zugehörungen" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000940> ;
        rf:role rv:Recipient ; rf:nameInSource "Abt und Grafen Anselm von Bobbio" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000940> ;
        rf:role rv:Petitioner ; rf:nameInSource "seine" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000377> ;
        rf:role rv:Petitioner ; rf:nameInSource "Erzbischofs, obersten Rates und Erzkanzlers Heinrich von Mainz" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A001202> ;
        rf:role rv:Petitioner ; rf:nameInSource "Erzbischofs Arnold von Köln" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000272> ;
        rf:role rv:Petitioner ; rf:nameInSource "Bischofs Ortlieb von Basel" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000843> ;
        rf:role rv:Petitioner ; rf:nameInSource "Markgrafen Hermann von Baden" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-U000179> ;
        rf:role rv:Petitioner ; rf:nameInSource "Grafen Ulrich von Lenzburg" ] ;
    rf:concerns <urn:regesta:22798:grafschaft-bobbio> ;
    rf:refersToAct <urn:regesta:22798:predecessor-privileges> ;
