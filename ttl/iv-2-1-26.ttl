# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1147-04-04_1_0_4_2_1_26_26

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22653> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 26" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-F000681> a crm:E21_Person ;
    rdfs:label "Herzog Friedrich II." .

# The succession act and the predecessor role remain model gaps: the act scheme has no succession type and the role scheme no predecessor role, so only Friedrich's holding of the duchy is recorded.
<urn:regesta:22653:parenthood-friedrich> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:source <urn:regesta:record:22653> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich folgt seinem Vater, Herzog Friedrich II." ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000681> ;
        rf:role rv:Parent ;
        rf:nameInSource "Herzog Friedrich II." ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Child ;
        rf:nameInSource "Friedrich" ] ;
    rf:qualifier "Vater" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-7> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22653:herzogtum-schwaben> a crm:E53_Place ;
    rdfs:label "Herzogtum Schwaben" .

<urn:regesta:22653:officeholding-schwaben> a rf:StateFactoid ;
    rf:factoidType rv:OfficeHolding ;
    rf:source <urn:regesta:record:22653> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich folgt seinem Vater, Herzog Friedrich II., im Herzogtum Schwaben nach" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Officeholder ;
        rf:nameInSource "Friedrich" ] ;
    rf:concerns <urn:regesta:22653:herzogtum-schwaben> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g2> ;
    rf:verificationStatus rv:unchecked .
