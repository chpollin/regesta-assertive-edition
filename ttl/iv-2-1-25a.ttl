# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/b9b7939c-d738-48a2-ab95-4a06f3387d54

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:220519> a crm:E31_Document .

# Actors

<urn:regesta:actor:RI004-002-F000681> a crm:E21_Person ;
    rdfs:label "Herzog Friedrich von Schwaben" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich (Barbarossa)" .

<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "König Konrad III." .

<urn:regesta:actor:RI004-002-J000275> a crm:E21_Person ;
    rdfs:label "Judith" .

# The register candidate is typed "ort" in the packet, but its label names a person.
<urn:regesta:actor:RI004-002-A000425> a crm:E21_Person ;
    rdfs:label "Agnes" .

<urn:regesta:actor:RI004-002-K000399> a crm:E21_Person ;
    rdfs:label "Konrad, den späteren Pfalzgrafen bei Rhein" .

# Kinship

<urn:regesta:220519:kinship-bruder> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:qualifier "Bruder" ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Herzog Friedrich von Schwaben (der Vater Friedrich Barbarossas) zürnt seinem Bruder, König Konrad III." ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000681> ; rf:role rv:Kin ;
            rf:nameInSource "Herzog Friedrich von Schwaben" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000316> ; rf:role rv:Kin ;
            rf:nameInSource "König Konrad III." ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:220519:parenthood-herzog-barbarossa> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:qualifier "Erstgeborenen" ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Herzog Friedrich von Schwaben (der Vater Friedrich Barbarossas)" ] ,
        [ a oa:TextQuoteSelector ;
        oa:exact "sein Sohn Friedrich (Barbarossa), den der Herzog als seinen Erstgeborenen" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000681> ; rf:role rv:Parent ;
            rf:nameInSource "Herzog Friedrich von Schwaben" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Child ;
            rf:nameInSource "Friedrich Barbarossas" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:220519:parenthood-judith-barbarossa> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "sein Sohn Friedrich (Barbarossa), den der Herzog als seinen Erstgeborenen und Sohn seiner überaus edlen früheren Frau (Judith)" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-J000275> ; rf:role rv:Parent ;
            rf:nameInSource "Judith" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Child ;
            rf:nameInSource "Friedrich (Barbarossa)" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:220519:marriage-judith> a rf:StateFactoid ;
    rf:factoidType rv:Marriage ;
    rf:qualifier "früheren Frau" ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "der Herzog als seinen Erstgeborenen und Sohn seiner überaus edlen früheren Frau (Judith)" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000681> ; rf:role rv:Spouse ;
            rf:nameInSource "der Herzog" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-J000275> ; rf:role rv:Spouse ;
            rf:nameInSource "Judith" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:220519:marriage-agnes> a rf:StateFactoid ;
    rf:factoidType rv:Marriage ;
    rf:qualifier "zweite Frau" ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "der Herzog als seinen Erstgeborenen und Sohn seiner überaus edlen früheren Frau (Judith) zum Erben seines Landes bestellt und die Obhut über seine zweite Frau (Agnes)" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000681> ; rf:role rv:Spouse ;
            rf:nameInSource "der Herzog" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000425> ; rf:role rv:Spouse ;
            rf:nameInSource "Agnes" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

# The regest calls Konrad "den noch kleinen Sohn" in the Herzog's provision; it does not name his mother.
<urn:regesta:220519:parenthood-herzog-konrad> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "der Herzog als seinen Erstgeborenen und Sohn seiner überaus edlen früheren Frau (Judith) zum Erben seines Landes bestellt und die Obhut über seine zweite Frau (Agnes) und den noch kleinen Sohn (Konrad, den späteren Pfalzgrafen bei Rhein)" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000681> ; rf:role rv:Parent ;
            rf:nameInSource "der Herzog" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000399> ; rf:role rv:Child ;
            rf:nameInSource "Konrad, den späteren Pfalzgrafen bei Rhein" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

# Legal acts of the Herzog, reported as earlier acts in the reason for his anger.

# The vocabulary has no act type for designating an heir; Enactment is used and the gap is reported.
<urn:regesta:220519:erbe-recht> a crm:E30_Right ;
    crm:P2_has_type rv:Inheritance ;
    rdfs:label "Erben seines Landes" .

<urn:regesta:220519:heir-designation> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "sein Sohn Friedrich (Barbarossa), den der Herzog als seinen Erstgeborenen und Sohn seiner überaus edlen früheren Frau (Judith) zum Erben seines Landes bestellt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000681> ; rf:role rv:Grantor ;
            rf:nameInSource "der Herzog" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Beneficiary ;
            rf:nameInSource "Friedrich (Barbarossa)" ] ;
    rf:concerns <urn:regesta:220519:erbe-recht> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:220519:entrusting-care> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:qualifier "die Obhut über seine zweite Frau (Agnes) und den noch kleinen Sohn (Konrad, den späteren Pfalzgrafen bei Rhein) anvertraut" ;
    rf:source <urn:regesta:record:220519> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "sein Sohn Friedrich (Barbarossa), den der Herzog als seinen Erstgeborenen und Sohn seiner überaus edlen früheren Frau (Judith) zum Erben seines Landes bestellt und die Obhut über seine zweite Frau (Agnes) und den noch kleinen Sohn (Konrad, den späteren Pfalzgrafen bei Rhein) anvertraut hat" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000681> ; rf:role rv:Grantor ;
            rf:nameInSource "der Herzog" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Recipient ;
            rf:nameInSource "Friedrich (Barbarossa)" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000425> ; rf:role rv:Beneficiary ;
            rf:nameInSource "Agnes" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000399> ; rf:role rv:Beneficiary ;
            rf:nameInSource "Konrad, den späteren Pfalzgrafen bei Rhein" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .
