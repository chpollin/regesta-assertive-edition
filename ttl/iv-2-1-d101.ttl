# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-06-00_2_0_4_2_1_101_D101

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22728> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. D101" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-R000317:community> a crm:E74_Group ;
    rdfs:label "Kloster St. Emmeram zu Regensburg" .

<urn:regesta:actor:RI004-002-R000315:community> a crm:E74_Group ;
    rdfs:label "Regensburger Bischofskirche" .

<urn:regesta:actor:RI004-002-M000434> a crm:E21_Person ;
    rdfs:label "Margaretas" .

<urn:regesta:actor:RI004-002-H000204> a crm:E21_Person ;
    rdfs:label "Klosterministerialen Hartwig von Herrnwahlthann (Danne)" .

<urn:regesta:actor:RI004-002-A000107> a crm:E21_Person ;
    rdfs:label "Abt Albert" .

<urn:regesta:actor:RI004-002-U000250> a crm:E21_Person ;
    rdfs:label "(Regensburger) Vitztum Ulrich" .

<urn:regesta:22728:paternal-fief> a crm:E18_Physical_Thing ;
    rdfs:label "das väterliche Lehen" .

<urn:regesta:22728:female-succession> a crm:E30_Right ;
    crm:P2_has_type rv:Inheritance ;
    rdfs:label "weibliche Erbfolge" .

# Confirmation by the ruler; it refers to the princes' judgment, which the regest reports as formulated earlier.
<urn:regesta:22728:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22728> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich bestätigt dem Kloster St. Emmeram zu Regensburg" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "einen vom (Regensburger) Vitztum Ulrich formulierten Fürstenspruch" ] ;
    rf:reference <urn:regesta:22728:confirmation-ref-friedrich> , <urn:regesta:22728:confirmation-ref-kloster> ;
    rf:refersToAct <urn:regesta:22728:judgment> ;
    rf:ground "auf Grund der Klage Margaretas" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22728:confirmation-ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22728:confirmation-ref-kloster> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-R000317:community> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Kloster St. Emmeram zu Regensburg" .

<urn:regesta:22728:dispute> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22728> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Klage Margaretas, der Tochter des ohne männlichen Erben verstorbenen Klosterministerialen Hartwig von Herrnwahlthann (Danne), gegen Abt Albert wegen ihres Anspruches auf das väterliche Lehen" ] ;
    rf:reference <urn:regesta:22728:dispute-ref-margareta> , <urn:regesta:22728:dispute-ref-albert> ;
    rf:concerns <urn:regesta:22728:paternal-fief> ;
    rf:ground "wegen ihres Anspruches auf das väterliche Lehen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22728:dispute-ref-margareta> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-M000434> ;
    rf:role rv:Claimant ;
    rf:nameInSource "Margaretas" .

<urn:regesta:22728:dispute-ref-albert> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-A000107> ;
    rf:role rv:Respondent ;
    rf:nameInSource "Abt Albert" .

# The princes' judgment as the regest states its content. No date; the regest does not say it decided Margareta's claim.
<urn:regesta:22728:judgment> a rf:ActFactoid ;
    rf:factoidType rv:Judgment ;
    rf:source <urn:regesta:record:22728> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "einen vom (Regensburger) Vitztum Ulrich formulierten Fürstenspruch, nach dem für Lehen des Klosters genauso wie für Lehen der Regensburger Bischofskirche die weibliche Erbfolge ausgeschlossen ist" ] ;
    rf:reference <urn:regesta:22728:judgment-ref-ulrich> ;
    rf:concerns <urn:regesta:22728:female-succession> ,
        <urn:regesta:actor:RI004-002-R000317:community> ,
        <urn:regesta:actor:RI004-002-R000315:community> ;
    rf:qualifier "ausgeschlossen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22728:judgment-ref-ulrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-U000250> ;
    rf:role rv:Participant ;
    rf:nameInSource "(Regensburger) Vitztum Ulrich" .

<urn:regesta:22728:parenthood-hartwig-margareta> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:source <urn:regesta:record:22728> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Margaretas, der Tochter des ohne männlichen Erben verstorbenen Klosterministerialen Hartwig von Herrnwahlthann (Danne)" ] ;
    rf:reference <urn:regesta:22728:parenthood-ref-hartwig> , <urn:regesta:22728:parenthood-ref-margareta> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22728:parenthood-ref-hartwig> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-H000204> ;
    rf:role rv:Parent ;
    rf:nameInSource "Klosterministerialen Hartwig von Herrnwahlthann (Danne)" .

<urn:regesta:22728:parenthood-ref-margareta> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-M000434> ;
    rf:role rv:Child ;
    rf:nameInSource "Margaretas" .

# "das väterliche Lehen" states that the father held a fief; the lord is not named in the passage.
<urn:regesta:22728:fief-hartwig> a rf:StateFactoid ;
    rf:factoidType rv:FeudalRelationship ;
    rf:source <urn:regesta:record:22728> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "das väterliche Lehen" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Klosterministerialen Hartwig von Herrnwahlthann (Danne)" ] ;
    rf:reference <urn:regesta:22728:fief-ref-hartwig> ;
    rf:concerns <urn:regesta:22728:paternal-fief> ;
    rf:qualifier "väterliche" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22728:fief-ref-hartwig> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-H000204> ;
    rf:role rv:Vassal ;
    rf:nameInSource "Klosterministerialen Hartwig von Herrnwahlthann (Danne)" .
