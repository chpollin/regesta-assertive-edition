# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-12-28_3_0_4_2_1_151_151

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22778> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-H000006> a crm:E21_Person ;
    rdfs:label "H. von Thiel (Tiela)" .

<urn:regesta:actor:RI004-002-F000203> a crm:E21_Person ;
    rdfs:label "Abtes" .

<urn:regesta:actor:RI004-002-F000204:community> a crm:E74_Group ;
    rdfs:label "Brüder" .

<urn:regesta:actor:RI004-002-F000201:community> a crm:E74_Group ;
    rdfs:label "Kirche von Floreffe" .

# Complaint of the abbot and the brothers, addressed to the ruler. The regest does not name who held the ship.
<urn:regesta:22778:complaint> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22778> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "auf Klagen des Abtes und der Brüder der Kirche von Floreffe" ] ;
    rf:reference <urn:regesta:22778:complaint:ref-abbot> ,
        <urn:regesta:22778:complaint:ref-brothers> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-37> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22778:complaint:ref-abbot> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000203> ;
    rf:role rv:Claimant ;
    rf:nameInSource "Abtes" .

<urn:regesta:22778:complaint:ref-brothers> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000204:community> ;
    rf:role rv:Claimant ;
    rf:nameInSource "Brüder" .

# Main act: order to release the ship.
<urn:regesta:22778:order-release> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22778> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich befiehlt seinem Ministerialen H. von Thiel (Tiela) auf Klagen des Abtes und der Brüder der Kirche von Floreffe, ein zur Verzollung festgehaltenes Schiff dieses Stiftes freizugeben" ] ;
    rf:reference <urn:regesta:22778:order-release:ref-friedrich> ,
        <urn:regesta:22778:order-release:ref-h-thiel> ,
        <urn:regesta:22778:order-release:ref-floreffe> ;
    rf:concerns <urn:regesta:22778:thing-ship> ;
    rf:ground "auf Klagen des Abtes und der Brüder der Kirche von Floreffe" ;
    rf:refersToAct <urn:regesta:22778:complaint> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-37> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22778:order-release:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22778:order-release:ref-h-thiel> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-H000006> ;
    rf:role rv:Addressee ;
    rf:nameInSource "H. von Thiel (Tiela)" .

<urn:regesta:22778:order-release:ref-floreffe> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000201:community> ;
    rf:role rv:Beneficiary ;
    rf:nameInSource "Kirche von Floreffe" .

<urn:regesta:22778:thing-ship> a crm:E18_Physical_Thing ;
    rdfs:label "ein zur Verzollung festgehaltenes Schiff dieses Stiftes" .

# Provision: prohibition of repeating such encroachments.
<urn:regesta:22778:prohibition> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22778> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich befiehlt seinem Ministerialen H. von Thiel (Tiela)" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "derartige Übergriffe nicht zu wiederholen" ] ;
    rf:reference <urn:regesta:22778:prohibition:ref-friedrich> ,
        <urn:regesta:22778:prohibition:ref-h-thiel> ;
    rf:partOf <urn:regesta:22778:order-release> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-37> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22778:prohibition:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22778:prohibition:ref-h-thiel> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-H000006> ;
    rf:role rv:Addressee ;
    rf:nameInSource "H. von Thiel (Tiela)" .

# State: the ship is said to belong to the house.
<urn:regesta:22778:possession-ship> a rf:StateFactoid ;
    rf:factoidType rv:Possession ;
    rf:source <urn:regesta:record:22778> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "der Kirche von Floreffe, ein zur Verzollung festgehaltenes Schiff dieses Stiftes" ] ;
    rf:reference <urn:regesta:22778:possession-ship:ref-floreffe> ;
    rf:concerns <urn:regesta:22778:thing-ship> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-37> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22778:possession-ship:ref-floreffe> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000201:community> ;
    rf:role rv:Possessor ;
    rf:nameInSource "dieses Stiftes" .
