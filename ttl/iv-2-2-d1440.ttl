# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-00-00_1_0_4_2_2_882_D1440

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:24069> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-O000360> a crm:E21_Person ;
    rdfs:label "Markgraf Otakar(III.) von Steier(mark)" .

# The vocabulary has no mining-right type; the general usage-rights concept is used and the gap is reported.
<urn:regesta:24069:bergregal> a crm:E30_Right ;
    crm:P2_has_type rv:UsageRights ;
    rdfs:label "Bergregal" .

<urn:regesta:24069:grant> a rf:ActFactoid ;
    rf:factoidType rv:RightGrant ;
    rf:source <urn:regesta:record:24069> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "(Friedrich) verleiht Markgraf Otakar(III.) von Steier(mark) das Bergregal." ] ;
    rf:reference <urn:regesta:24069:grant-ref-grantor> , <urn:regesta:24069:grant-ref-recipient> ;
    rf:concerns <urn:regesta:24069:bergregal> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:24069:grant-ref-grantor> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:24069:grant-ref-recipient> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-O000360> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Markgraf Otakar(III.) von Steier(mark)" .
