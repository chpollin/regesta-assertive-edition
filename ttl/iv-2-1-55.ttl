# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1151-00-00_1_0_4_2_1_55_55

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22682> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "König Konrad (III.)" .
<urn:regesta:actor:RI004-002-W000272> a crm:E21_Person ;
    rdfs:label "Herzog Welf (VI.)" .

# Main act. The contract has no type for a concluded peace settlement; rv:Enactment with the
# qualifier "Frieden" records the mediated settlement without asserting its observance
# (reported as model gap). The regest does not say that Konrad and Welf negotiated.
<urn:regesta:22682:peace> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:qualifier "Frieden" ;
    rf:source <urn:regesta:record:22682> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich vermittelt zwischen König Konrad (III.) und Herzog Welf (VI.) einen Frieden" ] ;
    rf:reference <urn:regesta:22682:peace-ref-friedrich> ,
        <urn:regesta:22682:peace-ref-konrad> ,
        <urn:regesta:22682:peace-ref-welf> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g3> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22682:peace-ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Mediator ;
    rf:nameInSource "Friedrich" .
<urn:regesta:22682:peace-ref-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000316> ;
    rf:role rv:Participant ;
    rf:nameInSource "König Konrad (III.)" .
<urn:regesta:22682:peace-ref-welf> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-W000272> ;
    rf:role rv:Participant ;
    rf:nameInSource "Herzog Welf (VI.)" .

# Provision: return of the prisoners to Welf. A provision of the peace, not its performance.
<urn:regesta:22682:prisoners> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:partOf <urn:regesta:22682:peace> ;
    rf:source <urn:regesta:record:22682> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "nach dem Welf die Gefangenen zurückerhält" ] ;
    rf:reference <urn:regesta:22682:prisoners-ref-welf> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-14> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22682:prisoners-ref-welf> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-W000272> ;
    rf:role rv:Beneficiary ;
    rf:nameInSource "Welf" .

# Provision: Welf's undertaking not to fight the king in future, in return for the prisoners.
<urn:regesta:22682:no-fighting> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:partOf <urn:regesta:22682:peace> ;
    rf:source <urn:regesta:record:22682> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "nach dem Welf die Gefangenen zurückerhält und dafür künftig nicht mehr gegen den König kämpfen wird" ] ;
    rf:qualifier "künftig" ;
    rf:reference <urn:regesta:22682:no-fighting-ref-welf> ,
        <urn:regesta:22682:no-fighting-ref-konrad> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-14> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22682:no-fighting-ref-welf> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-W000272> ;
    rf:role rv:Obligor ;
    rf:nameInSource "Welf" .
<urn:regesta:22682:no-fighting-ref-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000316> ;
    rf:role rv:Beneficiary ;
    rf:nameInSource "König" .

# Provision: imperial revenues with the village of Mertingen for Welf, read as a term of the
# peace without asserting a grantor or a completed transfer. Whether "außerdem" makes this a
# separate act is unresolved and remains open for expert review; the grantor is not named.
<urn:regesta:22682:revenues> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:partOf <urn:regesta:22682:peace> ;
    rf:source <urn:regesta:record:22682> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "außerdem erhält Welf auch Reichseinkünfte mit dem Dorf Mertingen" ] ;
    rf:reference <urn:regesta:22682:revenues-ref-welf> ;
    rf:concerns <urn:regesta:22682:reichseinkuenfte> , <urn:regesta:22682:mertingen> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g3> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22682:revenues-ref-welf> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-W000272> ;
    rf:role rv:Beneficiary ;
    rf:nameInSource "Welf" .

<urn:regesta:22682:reichseinkuenfte> a crm:E30_Right ;
    crm:P2_has_type rv:Revenue ;
    rdfs:label "Reichseinkünfte" .

<urn:regesta:22682:mertingen> a crm:E53_Place ;
    rdfs:label "Dorf Mertingen" .
