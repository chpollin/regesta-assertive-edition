    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich übt an einem Kloster bei Adrianopel" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "im Auftrag König Konrads III. Vergeltung" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000316> ; rf:role rv:Grantor ; rf:nameInSource "König Konrads III." ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Recipient ; rf:nameInSource "Friedrich" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-9> ;
