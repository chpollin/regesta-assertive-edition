# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1148-09-08_1_0_4_2_1_41_41

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22668> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "König Konrad III." .

<urn:regesta:actor:RI004-002-M000374> a crm:E21_Person ;
    rdfs:label "Kaiser Manuel" .

# Earlier act: the treaty. The vocabulary has no treaty or agreement type; Enactment is the
# closest concept and the parties carry Participant (reported as model gap).
<urn:regesta:22668:treaty> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22668> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "den Vertrag zwischen König Konrad III. und Kaiser Manuel, der ein gemeinsames Vorgehen gegen König Roger von Sizilien vorsieht" ] ;
    rf:reference <urn:regesta:22668:treaty-ref-konrad> , <urn:regesta:22668:treaty-ref-manuel> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-11> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22668:treaty-ref-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000316> ;
    rf:role rv:Participant ;
    rf:nameInSource "König Konrad III." .

<urn:regesta:22668:treaty-ref-manuel> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-M000374> ;
    rf:role rv:Participant ;
    rf:nameInSource "Kaiser Manuel" .

# Confirmation of the treaty by oath.
<urn:regesta:22668:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22668> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich bekräftigt eidlich den Vertrag zwischen König Konrad III. und Kaiser Manuel" ] ;
    rf:reference <urn:regesta:22668:confirmation-ref-friedrich> ;
    rf:refersToAct <urn:regesta:22668:treaty> ;
    rf:qualifier "eidlich" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-11> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22668:confirmation-ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .
