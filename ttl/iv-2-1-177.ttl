@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22804> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-B000794> a crm:E21_Person ;
    rdfs:label "Propst Bertram von Fredelsloh" .

<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "Konrad (III.)" .

<urn:regesta:actor:RI004-002-T000226> a crm:E21_Person ;
    rdfs:label "päpstlichen Legaten Bischof Thietwin (auch Dietwin)" .

<urn:regesta:actor:RI004-002-H001023:community> a crm:E74_Group ;
    rdfs:label "Reichsabtei Hilwartshausen (abbatiam in Hildewardeshusen ad ius regni pertinentem)" .

<urn:regesta:actor:22804:local:reich> a crm:E74_Group ;
    rdfs:label "regni" .

<urn:regesta:actor:22804:local:nonnen> a crm:E74_Group ;
    rdfs:label "die Nonnen" .

<urn:regesta:22804:propstwahl> a crm:E30_Right ;
    crm:P2_has_type rv:ChurchRights ;
    rdfs:label "die freie Propstwahl" .

<urn:regesta:22804:entfremdete-besitzungen> a crm:E18_Physical_Thing ;
    rdfs:label "entfremdeter Besitzungen" .

<urn:regesta:22804:vogtei> a crm:E30_Right ;
    crm:P2_has_type rv:Advocacy ;
    rdfs:label "die Vogtei" .

<urn:regesta:22804:konrad-grant> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22804> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "wie dies schon Konrad (III.) auf Bitten des päpstlichen Legaten Bischof Thietwin (auch Dietwin) tat" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-K000316> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Konrad (III.)" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-T000226> ;
        rf:role rv:Petitioner ;
        rf:nameInSource "Bischof Thietwin (auch Dietwin)" ] ;
    rf:concerns <urn:regesta:actor:RI004-002-H001023:community> ;
    rf:qualifier "schon" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-43> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22804:subordination> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22804> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich unterstellt die Reichsabtei Hilwartshausen (abbatiam in Hildewardeshusen ad ius regni pertinentem) dem Propst Bertram von Fredelsloh" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-B000794> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Propst Bertram von Fredelsloh" ] ;
    rf:concerns <urn:regesta:actor:RI004-002-H001023:community> ;
    rf:refersToAct <urn:regesta:22804:konrad-grant> ;
    rf:qualifier "unterstellt" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-43> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22804:abbey-reich> a rf:StateFactoid ;
    rf:factoidType rv:RightHolding ;
    rf:source <urn:regesta:record:22804> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "abbatiam in Hildewardeshusen ad ius regni pertinentem" ] ;
