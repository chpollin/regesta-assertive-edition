        rf:nameInSource "die Nonnen" ] ;
    rf:concerns <urn:regesta:22804:propstwahl> ;
    rf:condition "für den Fall des Todes oder des Verzichtes Bertrams auf seine Propstei" ;
    rf:partOf <urn:regesta:22804:subordination> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-43> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22804:rueckfall-provision> a rf:ActFactoid ;
