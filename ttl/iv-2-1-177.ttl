<urn:regesta:22804:propstwahl-provision> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22804> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "legt für den Fall des Todes oder des Verzichtes Bertrams auf seine Propstei die freie Propstwahl durch die Nonnen fest" ] ;
    rf:reference [ a rf:Reference ;
