<urn:regesta:22754:verweigerung-zustimmung> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22754> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "er zur Transferierung Wichmanns auf den Magdeburger Stuhl aus den dargelegten Gründen niemals seine Zustimmung geben werde" ] ;
