# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1153-03-00_1_0_4_2_1_168_D168

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22795> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-M000144:community> a crm:E74_Group ;
    rdfs:label "Mailänder" .

<urn:regesta:actor:RI004-002-A000547> a crm:E21_Person ;
    rdfs:label "Albernardus Alamanus" .

<urn:regesta:actor:RI004-002-H001179> a crm:E21_Person ;
    rdfs:label "Magister Homobonus von Lodi" .

<urn:regesta:22795:market-lodesaner> a crm:E30_Right ;
    crm:P2_has_type rv:Market ;
    rdfs:label "Marktes der Lodesaner" .

# The complaints; "ihnen" is read as the Milanese, the addressees of the mandate.
<urn:regesta:22795:complaints> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22795> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "nach Klagen der Bürger Albernardus Alamanus und Magister Homobonus von Lodi wegen der von ihnen gewaltsam vorgenommenen Verlegung eines Marktes der Lodesaner" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000547> ; rf:role rv:Claimant ; rf:nameInSource "Albernardus Alamanus" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001179> ; rf:role rv:Claimant ; rf:nameInSource "Magister Homobonus von Lodi" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000144:community> ; rf:role rv:Respondent ; rf:nameInSource "ihnen" ] ;
    rf:concerns <urn:regesta:22795:market-lodesaner> ;
    rf:ground "wegen der von ihnen gewaltsam vorgenommenen Verlegung eines Marktes der Lodesaner" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-41> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22795:mandate> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22795> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich erläßt an die Mailänder" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "ein Mandat" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000144:community> ; rf:role rv:Addressee ; rf:nameInSource "Mailänder" ] ;
    rf:concerns <urn:regesta:22795:market-lodesaner> ;
    rf:refersToAct <urn:regesta:22795:complaints> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-41> ;
    rf:verificationStatus rv:unchecked .
