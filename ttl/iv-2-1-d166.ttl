# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1153-03-00_2_0_4_2_1_166_D166

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22793> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

# The register entry names the representatives as a collective; typed as a group under the community IRI convention (REGISTER_ID:community).
<urn:regesta:actor:RI004-002-C000615:community> a crm:E74_Group ;
    rdfs:label "die Vertreter von Chiavenna" .

<urn:regesta:22793:grafschaft-chiavenna> a crm:E53_Place ;
    rdfs:label "Grafschaft Chiavenna" .

<urn:regesta:22793:summons> a rf:ActFactoid ;
    rf:factoidType rv:Communication ;
    rf:source <urn:regesta:record:22793> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich beruft die Vertreter von Chiavenna nach Konstanz" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-C000615:community> ; rf:role rv:Addressee ; rf:nameInSource "die Vertreter von Chiavenna" ] ;
    rf:concerns <urn:regesta:22793:grafschaft-chiavenna> ;
    rf:ground "um dort die strittige Frage der Zugehörigkeit der Grafschaft Chiavenna zu klären" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g9> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22793:dispute-chiavenna> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22793> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die strittige Frage der Zugehörigkeit der Grafschaft Chiavenna" ] ;
    rf:concerns <urn:regesta:22793:grafschaft-chiavenna> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-41> ;
    rf:verificationStatus rv:unchecked .
