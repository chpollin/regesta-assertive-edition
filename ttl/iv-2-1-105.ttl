# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-00-00_1_0_4_2_1_105_105

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22732> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich?" .

<urn:regesta:actor:RI004-002-G000230> a crm:E21_Person ;
    rdfs:label "König (Geisa II. ) von Ungarn" .

<urn:regesta:actor:22732:local:gesandter> a crm:E21_Person ;
    rdfs:label "seines Gesandten" .

<urn:regesta:22732:complaint> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22732> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "(Friedrich?) klagt bei König (Geisa II. ) von Ungarn über die Gefangennahme seines Gesandten" ] ;
    rf:reference <urn:regesta:22732:ref-friedrich> ,
        <urn:regesta:22732:ref-geisa> ,
        <urn:regesta:22732:ref-gesandter> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g6> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22732:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Claimant ;
    rf:nameInSource "Friedrich?" .

<urn:regesta:22732:ref-geisa> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-G000230> ;
    rf:role rv:Addressee ;
    rf:nameInSource "König (Geisa II. ) von Ungarn" .

<urn:regesta:22732:ref-gesandter> a rf:Reference ;
    rf:actor <urn:regesta:actor:22732:local:gesandter> ;
    rf:role rv:Participant ;
    rf:nameInSource "seines Gesandten" .
