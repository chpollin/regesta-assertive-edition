# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1153-06-00_5_1_4_2_1_187a_187a

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:134421> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-A001203> a crm:E21_Person ;
    rdfs:label "Arnold" .

<urn:regesta:actor:RI004-002-K000324> a crm:E21_Person ;
    rdfs:label "Konrad" .

<urn:regesta:134421:chancellorship-arnold> a rf:StateFactoid ;
    rf:factoidType rv:OfficeHolding ;
    rf:source <urn:regesta:record:134421> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "seinen Kanzler Arnold" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-A001203> ;
        rf:role rv:Officeholder ;
        rf:nameInSource "Arnold" ] ;
    rf:qualifier "seinen Kanzler" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-52> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:134421:appointment-arnold> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:134421> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "er seinen Kanzler Arnold (vgl. Reg. 178) in höchst ehrenvoller Weise in sein Amt als Erzbischof von Mainz einsetzt" ] ,
      [ a oa:TextQuoteSelector ; oa:exact "Friedrich hält einen Hoftag" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-A001203> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Arnold" ] ;
    rf:qualifier "Erzbischof von Mainz" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-52> ;
    rf:verificationStatus rv:unchecked .

# The passage names no appointing actor for Konrad; none is inferred.
<urn:regesta:134421:appointment-konrad> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:134421> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "desgleichen wird auch Konrad als Bischof von Eichstätt eingesetzt" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-K000324> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Konrad" ] ;
    rf:qualifier "Bischof von Eichstätt" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-52> ;
    rf:verificationStatus rv:unchecked .
