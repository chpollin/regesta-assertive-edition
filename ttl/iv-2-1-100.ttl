# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-06-00_1_0_4_2_1_100_100

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22727> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-G000781:community> a crm:E74_Group ;
    rdfs:label "Stift Gottesgnaden" .

<urn:regesta:actor:22727:local:koenig-konrad-iii> a crm:E21_Person ;
    rdfs:label "König Konrad (III.)" .

<urn:regesta:22727:besitzungen> a crm:E18_Physical_Thing ;
    rdfs:label "den genannten Besitzungen" .

<urn:regesta:22727:schutznahme-friedrich> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22727> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt das Stift Gottesgnaden an der Saale (ęcclesiam sancti Victoris, que vocatur Gratia dei et sita est supra fluvium Salam in archiepiscopatu Magdeburgensi) wie König Konrad (III.) mit den genannten Besitzungen in seinen Schutz" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-G000781:community> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Stift Gottesgnaden" ] ;
    rf:concerns <urn:regesta:22727:besitzungen> ;
    rf:refersToAct <urn:regesta:22727:schutznahme-konrad> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-25> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22727:schutznahme-konrad> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22727> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt das Stift Gottesgnaden an der Saale (ęcclesiam sancti Victoris, que vocatur Gratia dei et sita est supra fluvium Salam in archiepiscopatu Magdeburgensi) wie König Konrad (III.) mit den genannten Besitzungen in seinen Schutz" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:22727:local:koenig-konrad-iii> ;
        rf:role rv:Grantor ;
        rf:nameInSource "König Konrad (III.)" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-G000781:community> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Stift Gottesgnaden" ] ;
    rf:concerns <urn:regesta:22727:besitzungen> ;
    rf:qualifier "wie König Konrad (III.)" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-25> ;
    rf:verificationStatus rv:unchecked .
