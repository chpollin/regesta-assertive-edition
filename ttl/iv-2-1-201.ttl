# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1153-11-22_1_0_4_2_1_201_201

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22828> a crm:E31_Document .

<urn:regesta:actor:RI004-002-M000374> a crm:E21_Person ;
    rdfs:label "oströmische Kaiser Manuel" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "König Friedrich" .

<urn:regesta:actor:22828:local:boten> a crm:E74_Group ;
    rdfs:label "Boten" .

# The marriage negotiations are only planned; no Negotiation factoid and no marriage is asserted.
# The vocabulary has no sender role, so the sender carries rv:Participant (reported as model gap).
<urn:regesta:22828:mission> a rf:ActFactoid ;
    rf:factoidType rv:Mission ;
    rf:source <urn:regesta:record:22828> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Der oströmische Kaiser Manuel schickt wegen der geplanten Eheverhandlungen und der von ihm gewünschten Verbindung beider Reiche (Vult enim inperium meum magis ac magis utrorumque regnorum unitionem) Boten an König Friedrich." ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-M000374> ;
        rf:role rv:Participant ;
        rf:nameInSource "oströmische Kaiser Manuel" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:22828:local:boten> ;
        rf:role rv:Envoy ;
        rf:nameInSource "Boten" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Addressee ;
        rf:nameInSource "König Friedrich" ] ;
    rf:ground "wegen der geplanten Eheverhandlungen und der von ihm gewünschten Verbindung beider Reiche" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-49> ;
    rf:verificationStatus rv:unchecked .
