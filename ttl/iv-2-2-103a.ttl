# Judgment deciding the dispute

<urn:regesta:134441:judgment> a rf:ActFactoid ;
    rf:factoidType rv:Judgment ;
    rf:source <urn:regesta:record:134441> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Vor König Friedrich (coram rege Friderico) wird der Streit zwischen Eufemia, der Witwe Heinrichs von Hegilen, und dem Stift Berchtesgaden unter Propst Heinrich um Saline und Salzpfanne zu Reichenhall nach dem Zeugnis der Edelfreien Otto von Moos, Erbo von Biburg und Herbord von Hebingen durch Spruch des erwählten Richters Markgraf Engelbert von Kraiburg (Istrien) zugunsten des Stiftes entschieden." ] ;
    rf:refersToAct <urn:regesta:134441:dispute> ;
    rf:reference <urn:regesta:134441:judgment-ref-ruler> ,
        <urn:regesta:134441:judgment-ref-judge> ,
        <urn:regesta:134441:judgment-ref-stift> ,
        <urn:regesta:134441:judgment-ref-otto> ,
        <urn:regesta:134441:judgment-ref-erbo> ,
        <urn:regesta:134441:judgment-ref-herbord> ;
    rf:concerns <urn:regesta:134441:saline-salzpfanne-reichenhall> ;
    rf:qualifier "erwählten Richters" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-1> ;
    rf:verificationStatus rv:unchecked .

