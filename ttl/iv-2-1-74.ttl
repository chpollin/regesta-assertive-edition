# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-03-00_4_0_4_2_1_74_74

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22701> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-U000338:community> a crm:E74_Group ; rdfs:label "die Bürger von Utrecht" .
<urn:regesta:actor:RI004-002-H000820> a crm:E21_Person ; rdfs:label "Hermann" .

<urn:regesta:22701:fine> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22701> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich belegt die Bürger von Utrecht wegen ihrer Aufsässigkeit (contumacia) gegen König Konrad (III.) mit einer Geldbuße" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-U000338:community> ; rf:role rv:Obligor ; rf:nameInSource "die Bürger von Utrecht" ] ;
    rf:ground "wegen ihrer Aufsässigkeit (contumacia) gegen König Konrad (III.)" ;
    rf:qualifier "mit einer Geldbuße" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22701:confirmation-bishop> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22701> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "bestätigt Hermann als Bischof von Utrecht" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich belegt" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000820> ; rf:role rv:Recipient ; rf:nameInSource "Hermann" ] ;
    rf:qualifier "als Bischof von Utrecht" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .
