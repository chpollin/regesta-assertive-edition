# Sureties. The vocabulary has no surety role; rv:Obligor under an rv:Obligation state is the closest (model gap reported).
<urn:regesta:22721:buergen-koenig> a rf:StateFactoid ;
    rf:factoidType rv:Obligation ;
    rf:source <urn:regesta:record:22721> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Bürgen des Königs: Herzog Heinrich von Sachsen, dominus Welf, Kanzler Arnold, die Grafen Ulrich von Lenzburg, Egeno (wohl von Vaihingen) und Ulrich von Herrlingen" ] ,
                [ a oa:TextQuoteSelector ; oa:exact "Markward von Grumbach, Arnold von Biberbach, Pfalzgraf Otto von Wittelsbach, der Truchseß Walther, der Mundschenk Hildebrand, (der Reichsministeriale) Konrad Colbo und sein Bruder Siegfried" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "des Königs" ] ,
