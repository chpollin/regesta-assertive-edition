    rdfs:label "ihre Investitur" .
<urn:regesta:22721:burg-teck> a crm:E18_Physical_Thing ;
    rdfs:label "die Burg Teck (Thecche), mit allen Ministerialen und dazugehörigen Gütern" .
<urn:regesta:22721:oethlingen> a crm:E18_Physical_Thing ; rdfs:label "Oethlingen (Hetlingen)" .
<urn:regesta:22721:wellingen> a crm:E18_Physical_Thing ; rdfs:label "Wellingen (Willigen)" .
<urn:regesta:22721:erstein> a crm:E18_Physical_Thing ; rdfs:label "Erstein mit allen Pertinenzen" .

# Main act. The vocabulary has no act type for a bilateral agreement; rv:Enactment is the closest (model gap reported).

<urn:regesta:22721:vertrag> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22721> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich schließt mit Herzog Berthold (IV. von Zähringen) einen Vertrag über die Ordnung der Verhältnisse im Königreich Burgund" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "Friedrich" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000724> ; rf:role rv:Participant ; rf:nameInSource "Herzog Berthold (IV. von Zähringen)" ] ;
    rf:concerns <urn:regesta:22721:koenigreich-burgund> ;
    rf:qualifier "Vertrag" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-23> ;
    rf:verificationStatus rv:unchecked .

# Provisions of the agreement

<urn:regesta:22721:koenig-zug-uebergabe> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22721> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Der König verpflichtet sich, mit dem Herzog nach Burgund und in die Provence zu ziehen, ihm die Länder unterwerfen zu helfen und ihm zu übergeben" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Obligor ; rf:nameInSource "Der König" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000724> ; rf:role rv:Beneficiary ; rf:nameInSource "dem Herzog" ] ;
    rf:concerns <urn:regesta:22721:burgund> , <urn:regesta:22721:provence> ;
    rf:partOf <urn:regesta:22721:vertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-23> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22721:koenig-feldzugsfrist> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22721> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Der König wird seinen Feldzug in die genannten Länder vom nächsten 1. Juni in der 15. Indiktion (1152 Juni 1) an innerhalb eines Jahres antreten" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Obligor ; rf:nameInSource "Der König" ] ;
    rf:qualifier "vom nächsten 1. Juni in der 15. Indiktion (1152 Juni 1) an innerhalb eines Jahres" ;
    rf:partOf <urn:regesta:22721:vertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-23> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22721:wilhelm-rechenschaft> a rf:ActFactoid ;
