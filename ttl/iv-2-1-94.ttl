# Places, things and rights

<urn:regesta:22721:koenigreich-burgund> a crm:E53_Place ; rdfs:label "Königreich Burgund" .
<urn:regesta:22721:burgund> a crm:E53_Place ; rdfs:label "Burgund" .
<urn:regesta:22721:provence> a crm:E53_Place ; rdfs:label "Provence" .
<urn:regesta:22721:land-wilhelms> a crm:E53_Place ;
    rdfs:label "das Land, das er von seiner Nichte (Beatrix, die spätere Kaiserin) her innehat" .
<urn:regesta:22721:herrschaft-leitung> a crm:E30_Right ;
    crm:P2_has_type rv:LordshipRights ;
    rdfs:label "Herrschaft und Leitung beider Länder" .
<urn:regesta:22721:verfuegungsgewalt-bistuemer> a crm:E30_Right ;
