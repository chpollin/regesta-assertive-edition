    rf:source <urn:regesta:record:22721> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Graf Wilhelm von Mâcon muß über das Land, das er von seiner Nichte (Beatrix, die spätere Kaiserin) her innehat, dem Herzog Rechenschaft geben" ] ;
