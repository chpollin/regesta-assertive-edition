    rf:concerns <urn:regesta:22721:land-wilhelms> ;
    rf:partOf <urn:regesta:22721:vertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-23> ;
    rf:verificationStatus rv:unchecked .

