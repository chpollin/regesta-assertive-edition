@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22815> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-B000692> a crm:E21_Person ; rdfs:label "Äbtissin Bertha von Erstein" .
<urn:regesta:actor:RI004-002-H001317> a crm:E21_Person ; rdfs:label "Klostervogt Graf Hugo von Dagsburg" .
<urn:regesta:actor:RI004-002-H000843> a crm:E21_Person ; rdfs:label "Markgrafen Hermann von Baden" .
<urn:regesta:actor:RI004-002-A000420> a crm:E21_Person ; rdfs:label "Kaiserin Agnes" .
<urn:regesta:actor:RI004-002-E000504:community> a crm:E74_Group ; rdfs:label "dem Kloster" .

<urn:regesta:22815:thing-hof-besigheim> a crm:E18_Physical_Thing ; rdfs:label "Hof Besigheim ( Basincheim)" .

<urn:regesta:22815:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22815> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich bestätigt, daß die Äbtissin Bertha von Erstein" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ;
    rf:concerns <urn:regesta:22815:thing-hof-besigheim> ;
    rf:refersToAct <urn:regesta:22815:donation-bertha> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-46> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22815:donation-bertha> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22815> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die Äbtissin Bertha von Erstein durch ihn und den Klostervogt Graf Hugo von Dagsburg den Hof Besigheim ( Basincheim), den Kaiserin Agnes einst dem Kloster übergab, an den Markgrafen Hermann von Baden zu freiem Eigen geschenkt hat" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000692> ; rf:role rv:Grantor ; rf:nameInSource "Äbtissin Bertha von Erstein" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "ihn" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001317> ; rf:role rv:Representative ; rf:nameInSource "Klostervogt Graf Hugo von Dagsburg" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000843> ; rf:role rv:Recipient ; rf:nameInSource "Markgrafen Hermann von Baden" ] ;
    rf:concerns <urn:regesta:22815:thing-hof-besigheim> ;
    rf:qualifier "zu freiem Eigen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-46> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22815:grant-agnes> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22815> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "den Hof Besigheim ( Basincheim), den Kaiserin Agnes einst dem Kloster übergab" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000420> ; rf:role rv:Grantor ; rf:nameInSource "Kaiserin Agnes" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000504:community> ; rf:role rv:Recipient ; rf:nameInSource "dem Kloster" ] ;
    rf:concerns <urn:regesta:22815:thing-hof-besigheim> ;
    rf:qualifier "einst" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-46> ;
    rf:verificationStatus rv:unchecked .
