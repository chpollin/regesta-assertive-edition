@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22731> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "König" .

<urn:regesta:actor:RI004-002-H000470> a crm:E21_Person ;
    rdfs:label "Herzog (Heinrich ) von Sachsen" .

<urn:regesta:22731:herzogtum-bayern> a crm:E30_Right ;
    crm:P2_has_type rv:LordshipRights ;
    rdfs:label "Herzogtums Bayern" .

<urn:regesta:22731:bitte-rueckgabe> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22731> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Herzog (Heinrich ) von Sachsen bittet den König um Rückgabe des Herzogtums Bayern, um ihm im Notfall mit um so größerer Macht beistehen zu können" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-H000470> ;
        rf:role rv:Petitioner ;
        rf:nameInSource "Herzog (Heinrich ) von Sachsen" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Addressee ;
        rf:nameInSource "den König" ] ;
    rf:concerns <urn:regesta:22731:herzogtum-bayern> ;
    rf:qualifier "Rückgabe" ;
    rf:ground "um ihm im Notfall mit um so größerer Macht beistehen zu können" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-25> ;
    rf:verificationStatus rv:unchecked .
