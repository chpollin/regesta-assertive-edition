# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1147-03-19_1_0_4_2_1_25_25

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22652> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 25" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich, Herzog von Schwaben und vom Elsaß" .

<urn:regesta:actor:RI004-002-B001563> a crm:E21_Person ;
    rdfs:label "Bischof Burchard von Straßburg" .

<urn:regesta:actor:RI004-002-C000961:community> a crm:E74_Group ;
    rdfs:label "Kloster Corvey" .

<urn:regesta:actor:RI004-002-K000153:community> a crm:E74_Group ;
    rdfs:label "Kemnade" .

<urn:regesta:actor:RI004-002-F000181:community> a crm:E74_Group ;
    rdfs:label "Fischbeck" .

# Earlier donation of the two Stifte to Corvey; the regest names no donor and gives no date.
<urn:regesta:22652:donation-kemnade-fischbeck> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22652> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die dem Kloster Corvey geschenkten Stifte Kemnade und Fischbeck" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-C000961:community> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Kloster Corvey" ] ;
    rf:concerns <urn:regesta:actor:RI004-002-K000153:community> , <urn:regesta:actor:RI004-002-F000181:community> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-7> ;
    rf:verificationStatus rv:unchecked .

# The Fuerstenspruch: the Stifte shall remain free of all imperial services.
<urn:regesta:22652:fuerstenspruch> a rf:ActFactoid ;
    rf:factoidType rv:Judgment ;
    rf:source <urn:regesta:record:22652> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "einem von Bischof Burchard von Straßburg gefällten Fürstenspruch bei, nach dem die dem Kloster Corvey geschenkten Stifte Kemnade und Fischbeck auch weiterhin frei von allen Reichsdiensten sein sollen" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-B001563> ;
        rf:role rv:Judge ;
        rf:nameInSource "Bischof Burchard von Straßburg" ] ;
    rf:concerns <urn:regesta:actor:RI004-002-K000153:community> , <urn:regesta:actor:RI004-002-F000181:community> ;
    rf:qualifier "auch weiterhin" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-7> ;
    rf:verificationStatus rv:unchecked .

# Friedrich's accession (Beitritt) to the judgment; typed as confirmation for lack of an assent type (model gap).
<urn:regesta:22652:beitritt> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22652> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich, Herzog von Schwaben und vom Elsaß, tritt einem von Bischof Burchard von Straßburg gefällten Fürstenspruch bei" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich, Herzog von Schwaben und vom Elsaß" ] ;
    rf:refersToAct <urn:regesta:22652:fuerstenspruch> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-7> ;
    rf:verificationStatus rv:unchecked .
