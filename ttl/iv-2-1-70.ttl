<urn:regesta:22697:provision-koenigsbann> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22697> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "bestimmt, daß die Vogtei nur der mit dem Königsbann Belehnte (nisi quem constaret bannum regie auctoritatis habere) ausüben dürfe" ] ;
