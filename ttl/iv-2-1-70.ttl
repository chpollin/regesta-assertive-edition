<urn:regesta:22697:prohibition-abgaben> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22697> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "verbietet das Eintreiben von Abgaben in einer Höhe, die dem Zeugnis und den Urkunden der Schöffen und Dorfbewohner (quod auctoritas privilegiorum et testimonium scabinorum et villarum fidelium perhiberet veraci attestatione) widerspricht" ] ;
    rf:partOf <urn:regesta:22697:enactment-voegte> ;
    rf:concerns <urn:regesta:22697:right-abgaben> ;
    rf:qualifier "verbietet" ;
    rf:condition "in einer Höhe, die dem Zeugnis und den Urkunden der Schöffen und Dorfbewohner (quod auctoritas privilegiorum et testimonium scabinorum et villarum fidelium perhiberet veraci attestatione) widerspricht" ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-17> ;
    rf:verificationStatus rv:unchecked .

