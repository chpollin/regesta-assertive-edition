# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1146-12-27_1_0_4_2_1_19_19

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22646> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 19" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "König Konrad III." .

# Taking the cross at the urging of Bernhard von Clairvaux is not recorded: a crusade vow has no
# act type in the contract and is not a kinship, economic or legal relation as stated here.
<urn:regesta:22646:kinship-oheim> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:qualifier "Oheim" ;
    rf:source <urn:regesta:record:22646> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "gemeinsam mit seinem Oheim, König Konrad III." ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
            rf:role rv:Kin ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000316> ;
            rf:role rv:Kin ; rf:nameInSource "König Konrad III." ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-5> ;
    rf:verificationStatus rv:unchecked .
