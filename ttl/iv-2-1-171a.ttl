@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:210553> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:210553:local:kloster-settimo> a crm:E74_Group ;
    rdfs:label "(Benediktiner-)Kloster (S. Salvatore a) Settimo" .

<urn:regesta:210553:protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:210553> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt das (Benediktiner-)Kloster (S. Salvatore a) Settimo in seinen Schutz." ] ;
    rf:reference <urn:regesta:210553:protection-ref-grantor> , <urn:regesta:210553:protection-ref-recipient> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-53> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:210553:protection-ref-grantor> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:210553:protection-ref-recipient> a rf:Reference ;
    rf:actor <urn:regesta:actor:210553:local:kloster-settimo> ;
    rf:role rv:Recipient ;
    rf:nameInSource "(Benediktiner-)Kloster (S. Salvatore a) Settimo" .
