<urn:regesta:record:22753> a crm:E31_Document .

<urn:regesta:actor:RI004-002-E000589> a crm:E21_Person ;
    rdfs:label "Papst Eugen (III.)" .

<urn:regesta:actor:RI004-002-M000042:community> a crm:E74_Group ;
    rdfs:label "Magdeburger Domkapitel" .

<urn:regesta:actor:RI004-002-W000436> a crm:E21_Person ;
    rdfs:label "Bischof von Zeitz (Wichmann)" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "König" .

<urn:regesta:actor:RI004-002-M000041:community> a crm:E74_Group ;
    rdfs:label "Kirche von Magdeburg" .

<urn:regesta:22753:magdeburger-stuhl> a crm:E30_Right ;
    crm:P2_has_type rv:ChurchRights ;
    rdfs:label "den Magdeburger Stuhl" .

<urn:regesta:22753:amt-und-pfruende> a crm:E30_Right ;
    crm:P2_has_type rv:ChurchRights ;
    rdfs:label "Amt und Pfründe" .

<urn:regesta:22753:befehl> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22753> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Papst Eugen (III.) befiehlt dem Magdeburger Domkapitel , dem Bischof von Zeitz (Wichmann)" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "keinerlei Unterstützung zu leisten, wenn dieser in die Kirche von Magdeburg eindringen wolle" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Grantor ; rf:nameInSource "Papst Eugen (III.)" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000042:community> ; rf:role rv:Addressee ; rf:nameInSource "Magdeburger Domkapitel" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000436> ; rf:role rv:Participant ; rf:nameInSource "Bischof von Zeitz (Wichmann)" ] ;
    rf:concerns <urn:regesta:actor:RI004-002-M000041:community> ;
    rf:condition "wenn dieser in die Kirche von Magdeburg eindringen wolle" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-31> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22753:strafandrohung> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22753> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "droht bei Zuwiderhandlung den Verlust von Amt und Pfründe an" ] ;
    rf:partOf <urn:regesta:22753:befehl> ;
    rf:concerns <urn:regesta:22753:amt-und-pfruende> ;
    rf:condition "bei Zuwiderhandlung" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-31> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22753:investitur> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22753> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "der sich durch königliche Gunst den Magdeburger Stuhl zu verschaffen wußte und vom König auch schon investiert worden sei" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "König" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000436> ; rf:role rv:Recipient ; rf:nameInSource "Bischof von Zeitz (Wichmann)" ] ;
    rf:concerns <urn:regesta:22753:magdeburger-stuhl> ;
    rf:qualifier "durch königliche Gunst" , "auch schon" , "investiert worden sei" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g7> ;
    rf:verificationStatus rv:unchecked .
