<urn:regesta:record:22658> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 31" .

<urn:regesta:actor:RI004-002-H000343> a crm:E21_Person ;
    rdfs:label "König Heinrich (VI.)" .

<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "König Konrads III." .

# The fixed-term contract about castles, Dienstleute and Allodialgüter is not extracted: the contract
# has no act type for a bilateral agreement, and the model cannot express the alternative party
# "(Friedrich, Herzog von Schwaben, oder Graf Gebhard von Sulzbach)". Both are reported as model gaps.

<urn:regesta:22658:parenthood-heinrich> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:source <urn:regesta:record:22658> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "König Heinrich (VI.), dem Sohn König Konrads III." ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000316> ; rf:role rv:Parent ; rf:nameInSource "König Konrads III." ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000343> ; rf:role rv:Child ; rf:nameInSource "König Heinrich (VI.)" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-8> ;
    rf:verificationStatus rv:unchecked .
