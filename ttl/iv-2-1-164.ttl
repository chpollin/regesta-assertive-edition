<urn:regesta:actor:RI004-002-H001250> a crm:E21_Person ; rdfs:label "Ubald von S. Prassede" .
<urn:regesta:actor:RI004-002-B000622> a crm:E21_Person ; rdfs:label "Berhard von S. Clemente" .
