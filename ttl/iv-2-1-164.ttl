<urn:regesta:actor:RI004-002-R000856> a crm:E21_Person ; rdfs:label "Roland von S. Marco" .
<urn:regesta:actor:RI004-002-G000973> a crm:E21_Person ; rdfs:label "Gregor von S. Angelo" .
<urn:regesta:actor:RI004-002-G001157> a crm:E21_Person ; rdfs:label "Wido von S. Maria in Porticu" .
<urn:regesta:actor:RI004-002-B001492> a crm:E21_Person ; rdfs:label "Abt Bruno von Chiaravalle (Caravalle)" .
