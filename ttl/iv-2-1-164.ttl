<urn:regesta:actor:RI004-002-H000817> a crm:E21_Person ; rdfs:label "Hermann von Konstanz" .
<urn:regesta:actor:RI004-002-U000179> a crm:E21_Person ; rdfs:label "Ulrich von Lenzburg" .
<urn:regesta:actor:RI004-002-G001187> a crm:E21_Person ; rdfs:label "Guido Guerra" .
