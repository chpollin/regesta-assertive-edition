# Conclusion of the preliminary treaty through the negotiators (no treaty act type in the vocabulary)
<urn:regesta:22791:vorvertrag> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich schließt mit Papst Eugen III. durch die päpstlichen Unterhändler, die Kardinäle Gregor von S. Maria in Trastevere, Ubald von S. Prassede, Berhard von S. Clemente, Oktavian von S. Cecilia, Roland von S. Marco, Gregor von S. Angelo, Wido von S. Maria in Porticu sowie Abt Bruno von Chiaravalle (Caravalle) und die königlichen Unterhändler, die Bischöfe Anselm von Havelberg und Hermann von Konstanz sowie die Grafen Ulrich von Lenzburg, Guido Guerra, Guido von Biandrate folgenden Vorvertrag" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Participant ; rf:nameInSource "Papst Eugen III." ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G000972> ; rf:role rv:Negotiator ; rf:nameInSource "Gregor von S. Maria in Trastevere" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001250> ; rf:role rv:Negotiator ; rf:nameInSource "Ubald von S. Prassede" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000622> ; rf:role rv:Negotiator ; rf:nameInSource "Berhard von S. Clemente" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000158> ; rf:role rv:Negotiator ; rf:nameInSource "Oktavian von S. Cecilia" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000856> ; rf:role rv:Negotiator ; rf:nameInSource "Roland von S. Marco" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G000973> ; rf:role rv:Negotiator ; rf:nameInSource "Gregor von S. Angelo" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G001157> ; rf:role rv:Negotiator ; rf:nameInSource "Wido von S. Maria in Porticu" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B001492> ; rf:role rv:Negotiator ; rf:nameInSource "Abt Bruno von Chiaravalle (Caravalle)" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000934> ; rf:role rv:Negotiator ; rf:nameInSource "Anselm von Havelberg" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000817> ; rf:role rv:Negotiator ; rf:nameInSource "Hermann von Konstanz" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-U000179> ; rf:role rv:Negotiator ; rf:nameInSource "Ulrich von Lenzburg" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G001187> ; rf:role rv:Negotiator ; rf:nameInSource "Guido Guerra" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G001180> ; rf:role rv:Negotiator ; rf:nameInSource "Guido von Biandrate" ] ;
    rf:qualifier "Vorvertrag" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-40> ;
    rf:verificationStatus rv:unchecked .

# 1) The king's pledge not to make truce or peace without papal consent
<urn:regesta:22791:p1-kein-frieden> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Der König wird durch den Eid eines Reichsministerialen und persönlichen Handschlag (rex iurare faciet unum de ministerialibus regni in anima regis et ipse idem manu propria data fide) in die Hand des päpstlichen Legaten dem Papst geloben, weder Waffenstillstand noch Frieden (nec trevam nec pacem) mit den Römern und Roger von Sizilien ohne freie Zustimmung der römischen Kirche und des Papstes Eugen (III.) oder seiner Nachfolger, die den Vertrag mit ihm bewahren wollen, zu schließen" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Der König" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Addressee ; rf:nameInSource "dem Papst" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:22791:local:reichsministeriale> ; rf:role rv:Representative ; rf:nameInSource "eines Reichsministerialen" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:22791:local:paepstlicher-legat> ; rf:role rv:Representative ; rf:nameInSource "des päpstlichen Legaten" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000923:community> ; rf:role rv:Participant ; rf:nameInSource "Römern" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000806> ; rf:role rv:Participant ; rf:nameInSource "Roger von Sizilien" ] ;
    rf:qualifier "durch den Eid eines Reichsministerialen und persönlichen Handschlag" , "weder Waffenstillstand noch Frieden" ;
    rf:condition "ohne freie Zustimmung der römischen Kirche und des Papstes Eugen (III.) oder seiner Nachfolger, die den Vertrag mit ihm bewahren wollen" ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-40> ;
    rf:verificationStatus rv:unchecked .

# 1) The king's pledge to work towards subjecting the Romans
<urn:regesta:22791:p1-roemer-unterwerfen> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "nach Kräften seines Reiches daran zu arbeiten, die Römer zu unterwerfen, wie vor 100 Jahren" ] ,
      [ a oa:TextQuoteSelector ; oa:exact "Der König wird" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Der König" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000923:community> ; rf:role rv:Participant ; rf:nameInSource "die Römer" ] ;
    rf:qualifier "nach Kräften seines Reiches" , "wie vor 100 Jahren" ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-40> ;
    rf:verificationStatus rv:unchecked .

# 2) The king's pledge to preserve and defend papal rights and regalia
<urn:regesta:22791:p2-regalien> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Die Gerechtsame des Papsttums und die Regalien des hl. Petrus (honorem papatus et regalia beati Petri) wird er als Schutzvogt der römischen Kirche nach seinem Vermögen bewahren und verteidigen und das derzeit Entfremdete nach Kräften wiederzugewinnen helfen und das Wiedergewonnene dann verteidigen" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "er" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000886:community> ; rf:role rv:Beneficiary ; rf:nameInSource "römischen Kirche" ] ;
    rf:concerns <urn:regesta:22791:gerechtsame-papsttum> ;
    rf:qualifier "als Schutzvogt der römischen Kirche" , "nach seinem Vermögen" , "das derzeit Entfremdete nach Kräften wiederzugewinnen helfen" ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-40> ;
    rf:verificationStatus rv:unchecked .

# 3) The king's pledges concerning the Greek ruler: the unconditional non-concession and the
# expulsion promise, which alone carries the condition
<urn:regesta:22791:p3-keine-gebiete-koenig> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Auch dem griechischen Herrscher wird er keine Gebiete diesseits des Meeres zugestehen" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "er" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:22791:local:griechischer-herrscher> ; rf:role rv:Participant ; rf:nameInSource "dem griechischen Herrscher" ] ;
    rf:concerns <urn:regesta:22791:gebiete-diesseits> ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22791:p3-vertreibung-koenig> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Auch dem griechischen Herrscher wird er" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "im Falle einer Invasion sich nach Kräften bemühen, ihn möglichst rasch zu vertreiben" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "er" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:22791:local:griechischer-herrscher> ; rf:role rv:Participant ; rf:nameInSource "dem griechischen Herrscher" ] ;
    rf:condition "im Falle einer Invasion" ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

# 4) The pope's promise to crown the king and to support the royal rights
<urn:regesta:22791:p4-kroenung> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Der Papst verspricht kraft seines apostolischen Amtes gemeinsam mit den genannten Kardinälen in Gegenwart der königlichen Unterhändler, er werde den nach Rom zur Kaiserkrönung kommenden Konig (venientem pro plenitudine coronę suę), soweit es an ihm liegt, ohne Schwierigkeit und Widerspruch krönen und, wie es sein Amt gebiete, zur Bewahrung und Vermehrung der königlichen Gerechtsame beitragen" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Grantor ; rf:nameInSource "Der Papst" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Beneficiary ; rf:nameInSource "den nach Rom zur Kaiserkrönung kommenden Konig" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G000972> ; rf:role rv:Grantor ; rf:nameInSource "den genannten Kardinälen" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001250> ; rf:role rv:Grantor ; rf:nameInSource "den genannten Kardinälen" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000622> ; rf:role rv:Grantor ; rf:nameInSource "den genannten Kardinälen" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000158> ; rf:role rv:Grantor ; rf:nameInSource "den genannten Kardinälen" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000856> ; rf:role rv:Grantor ; rf:nameInSource "den genannten Kardinälen" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G000973> ; rf:role rv:Grantor ; rf:nameInSource "den genannten Kardinälen" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G001157> ; rf:role rv:Grantor ; rf:nameInSource "den genannten Kardinälen" ] ;
    rf:concerns <urn:regesta:22791:koenigliche-gerechtsame> ;
    rf:qualifier "kraft seines apostolischen Amtes" , "ohne Schwierigkeit und Widerspruch" ;
    rf:condition "soweit es an ihm liegt" ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

# 5) The pope's promise to admonish and if necessary excommunicate violators of the rights of the realm
<urn:regesta:22791:p5-exkommunikation> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Wer sich anmaßen sollte, die Gerechtsame des Reiches (iusticiam et honorem regni) zu mißachten, den wird der Papst, auf Ersuchen des Königs, zur Genugtuung ermahnen und nötigenfalls exkommunizieren" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Grantor ; rf:nameInSource "der Papst" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Beneficiary ; rf:nameInSource "des Königs" ] ;
    rf:concerns <urn:regesta:22791:gerechtsame-reich> ;
    rf:condition "auf Ersuchen des Königs" , "nötigenfalls" , "Wer sich anmaßen sollte, die Gerechtsame des Reiches (iusticiam et honorem regni) zu mißachten" ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

# 6) The pope's pledges concerning the Greek ruler: the unconditional non-concession and the
# expulsion promise, which alone carries the condition
<urn:regesta:22791:p6-kein-land-papst> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Dem griechischen Herrscher wird auch der Papst diesseits des Meeres kein Land zugestehen" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Grantor ; rf:nameInSource "der Papst" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:22791:local:griechischer-herrscher> ; rf:role rv:Participant ; rf:nameInSource "Dem griechischen Herrscher" ] ;
    rf:concerns <urn:regesta:22791:gebiete-diesseits> ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22791:p6-vertreibung-papst> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22791> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Dem griechischen Herrscher wird auch der Papst" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "im Falle einer Invasion sich nach Kräften bemühen, ihn möglichst rasch zu vertreiben" ] ;
    rf:reference
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Grantor ; rf:nameInSource "der Papst" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:22791:local:griechischer-herrscher> ; rf:role rv:Participant ; rf:nameInSource "Dem griechischen Herrscher" ] ;
    rf:condition "im Falle einer Invasion" ;
    rf:partOf <urn:regesta:22791:vorvertrag> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .
