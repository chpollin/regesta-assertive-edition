<urn:regesta:actor:RI004-002-H000840> a crm:E21_Person ;
    rdfs:label "Priester Hermann von Altsteußlingen" .
<urn:regesta:actor:22757:local:burchard> a crm:E21_Person ;
    rdfs:label "seinem Bruder Burchard" .

<urn:regesta:22757:gueter-salem> a crm:E18_Physical_Thing ;
    rdfs:label "die dem Kloster Salem in seiner Gegenwart geschenkten Güter und Besitzungen" .
<urn:regesta:22757:kirche-frankenhofen> a crm:E18_Physical_Thing ;
    rdfs:label "Kirche von Frankenhofen" .
<urn:regesta:22757:hufen-hohonbuach> a crm:E18_Physical_Thing ;
    rdfs:label "fünf Hufen in Hohonbuach" .
<urn:regesta:22757:hof-tiefenhuelen> a crm:E18_Physical_Thing ;
    rdfs:label "Tiefenhülen (Tufenhuluwe)" .
<urn:regesta:22757:hof-bremfeld> a crm:E18_Physical_Thing ;
    rdfs:label "Bremfeld" .
<urn:regesta:22757:hof-hohonbuach> a crm:E18_Physical_Thing ;
    rdfs:label "Hof Hohonbuach" .

<urn:regesta:22757:protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22757> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt die dem Kloster Salem in seiner Gegenwart geschenkten Güter und Besitzungen in seinen Schutz" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
            rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S000091:community> ;
            rf:role rv:Recipient ; rf:nameInSource "Kloster Salem" ] ;
    rf:concerns <urn:regesta:22757:gueter-salem> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-32> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22757:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22757> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "bestätigt folgende im einzelnen" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt die dem Kloster Salem" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
            rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S000091:community> ;
            rf:role rv:Recipient ; rf:nameInSource "Kloster Salem" ] ;
    rf:refersToAct <urn:regesta:22757:donation-ulrich> , <urn:regesta:22757:donation-tuebingen> ,
        <urn:regesta:22757:donation-ernst> , <urn:regesta:22757:donation-hermann> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-32> ;
    rf:verificationStatus rv:unchecked .

# The four earlier donations as the confirmation lists them; none is dated. The consent of wives
# and sons has no role in the vocabulary and is recorded as Participant (model gap).
<urn:regesta:22757:donation-ulrich> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22757> ;
    rf:evidence [ a oa:TextQuoteSelector ;
            oa:exact "die von Ulrich von Herrlingen (Hurninge) mit Zustimmung seiner Gemahlin und seines Sohnes Ulrich übergebene Kirche von Frankenhofen" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "dem Kloster Salem in seiner Gegenwart geschenkten Güter" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:22757:local:ulrich-von-herrlingen> ;
            rf:role rv:Grantor ; rf:nameInSource "Ulrich von Herrlingen (Hurninge)" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22757:local:gemahlin-ulrich> ;
            rf:role rv:Participant ; rf:nameInSource "seiner Gemahlin" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22757:local:ulrich-sohn> ;
            rf:role rv:Participant ; rf:nameInSource "Ulrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S000091:community> ;
            rf:role rv:Recipient ; rf:nameInSource "Kloster Salem" ] ;
    rf:concerns <urn:regesta:22757:kirche-frankenhofen> ;
    rf:condition "mit Zustimmung seiner Gemahlin und seines Sohnes Ulrich" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-32> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22757:donation-tuebingen> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22757> ;
    rf:evidence [ a oa:TextQuoteSelector ;
            oa:exact "von Pfalzgraf Friedrich von Tübingen gemeinsam mit seinem Ministerialen Eticho fünf Hufen in Hohonbuach" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "dem Kloster Salem in seiner Gegenwart geschenkten Güter" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000687> ;
            rf:role rv:Grantor ; rf:nameInSource "Pfalzgraf Friedrich von Tübingen" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000568> ;
            rf:role rv:Grantor ; rf:nameInSource "Eticho" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S000091:community> ;
            rf:role rv:Recipient ; rf:nameInSource "Kloster Salem" ] ;
    rf:concerns <urn:regesta:22757:hufen-hohonbuach> ;
    rf:amount "fünf Hufen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-32> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22757:donation-ernst> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22757> ;
    rf:evidence [ a oa:TextQuoteSelector ;
            oa:exact "die von Ernst von Altsteußlingen (Stuzelinge) mit Zustimmung seiner Gemahlin und seiner Söhne geschenkten Höfe Tiefenhülen (Tufenhuluwe) und Bremfeld" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "dem Kloster Salem in seiner Gegenwart geschenkten Güter" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000499> ;
            rf:role rv:Grantor ; rf:nameInSource "Ernst von Altsteußlingen (Stuzelinge)" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22757:local:gemahlin-ernst> ;
            rf:role rv:Participant ; rf:nameInSource "seiner Gemahlin" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22757:local:soehne-ernst> ;
            rf:role rv:Participant ; rf:nameInSource "seiner Söhne" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S000091:community> ;
            rf:role rv:Recipient ; rf:nameInSource "Kloster Salem" ] ;
    rf:concerns <urn:regesta:22757:hof-tiefenhuelen> , <urn:regesta:22757:hof-bremfeld> ;
    rf:condition "mit Zustimmung seiner Gemahlin und seiner Söhne" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-32> ;
    rf:verificationStatus rv:unchecked .

