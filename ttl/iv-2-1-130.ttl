<urn:regesta:record:22757> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 130" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-S000091:community> a crm:E74_Group ;
    rdfs:label "Kloster Salem" .
# Two register candidates (U000176, U000177) both match "Ulrich von Herrlingen" by name and
# title, and the passage does not decide between them, so donor and son stay regest-local.
<urn:regesta:actor:22757:local:ulrich-von-herrlingen> a crm:E21_Person ;
    rdfs:label "Ulrich von Herrlingen (Hurninge)" .
<urn:regesta:actor:22757:local:ulrich-sohn> a crm:E21_Person ;
    rdfs:label "seines Sohnes Ulrich" .
<urn:regesta:actor:22757:local:gemahlin-ulrich> a crm:E21_Person ;
    rdfs:label "seiner Gemahlin" .
<urn:regesta:actor:RI004-002-F000687> a crm:E21_Person ;
    rdfs:label "Pfalzgraf Friedrich von Tübingen" .
<urn:regesta:actor:RI004-002-E000568> a crm:E21_Person ;
    rdfs:label "Eticho" .
<urn:regesta:actor:RI004-002-E000499> a crm:E21_Person ;
    rdfs:label "Ernst von Altsteußlingen (Stuzelinge)" .
<urn:regesta:actor:22757:local:gemahlin-ernst> a crm:E21_Person ;
