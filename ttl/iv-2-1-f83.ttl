# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-05-02_1_0_4_2_1_83_F83

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22710> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-J000286:community> a crm:E74_Group ;
    rdfs:label "Familie Giuliano in Triest" .

<urn:regesta:actor:RI004-002-D000157> a crm:E21_Person ;
    rdfs:label "Didius Julianus" .

<urn:regesta:actor:22710:local:mitglieder> a crm:E74_Group ;
    rdfs:label "ihre Mitglieder" .

<urn:regesta:22710:protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22710> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt die von seinem Vorgänger Didius Julianus abstammende Familie Giuliano in Triest in seinen Schutz" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-J000286:community> ;
        rf:role rv:Recipient ; rf:nameInSource "Familie Giuliano in Triest" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-20> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22710:descent> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:22710> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "von seinem Vorgänger Didius Julianus abstammende Familie Giuliano in Triest" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-D000157> ;
        rf:role rv:Kin ; rf:nameInSource "Didius Julianus" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-J000286:community> ;
        rf:role rv:Kin ; rf:nameInSource "Familie Giuliano in Triest" ] ;
    rf:qualifier "abstammende" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-20> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22710:arms-grant> a rf:ActFactoid ;
    rf:factoidType rv:RightGrant ;
    rf:source <urn:regesta:record:22710> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "gestattet ihr, einen gekrönten schwarzen Adler im Wappen zu führen" ] ,
      [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-J000286:community> ;
        rf:role rv:Recipient ; rf:nameInSource "ihr" ] ;
    rf:qualifier "einen gekrönten schwarzen Adler im Wappen zu führen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-20> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22710:appointment> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22710> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "ernennt ihre Mitglieder zu Pfalzgrafen" ] ,
      [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:22710:local:mitglieder> ;
        rf:role rv:Recipient ; rf:nameInSource "ihre Mitglieder" ] ;
    rf:qualifier "zu Pfalzgrafen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-20> ;
    rf:verificationStatus rv:unchecked .
