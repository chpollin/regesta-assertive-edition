# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1147-04-20_1_0_4_2_1_27_27

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22654> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 27" .

<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "König Konrad III." .

<urn:regesta:actor:RI004-002-E000011> a crm:E21_Person ;
    rdfs:label "Bischof Eberhard (II.)" .

<urn:regesta:actor:RI004-002-B000133:community> a crm:E74_Group ;
    rdfs:label "Bamberger Ministerialien" .

# Identification with the shared ruler is a reading; candidate RI004-002-F000681 also matches by name and title.
<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Herzog Friedrichs von Schwaben" .

<urn:regesta:22654:right-schutz> a crm:E30_Right ;
    crm:P2_has_type rv:Protection ;
    rdfs:label "in graciam tuitionis et protectionis" .

# Earlier handover of the ministerials by the bishop to the king; no date asserted.
<urn:regesta:22654:uebergabe> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22654> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die ihm von Bischof Eberhard (II.) wegen ihrer Bedrückung durch Konrad von Rietfeld und Berengar von Albeck übergeben worden sind" ] ,
      [ a oa:TextQuoteSelector ; oa:exact "die genannten Bamberger Ministerialien" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-E000011> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Bischof Eberhard (II.)" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-K000316> ;
        rf:role rv:Recipient ;
        rf:nameInSource "ihm" ] ;
    rf:concerns <urn:regesta:actor:RI004-002-B000133:community> ;
    rf:ground "wegen ihrer Bedrückung durch Konrad von Rietfeld und Berengar von Albeck" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-7> ;
    rf:verificationStatus rv:unchecked .

# The king commits the ministerials to the duke's protection, explicitly not as advocacy.
<urn:regesta:22654:schutzunterstellung> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22654> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "König Konrad III. unterstellt die genannten Bamberger Ministerialien" ] ,
      [ a oa:TextQuoteSelector ; oa:exact "dem Schutz Herzog Friedrichs von Schwaben (in manus Friderici ducis Suevię non in ius advocatię sed in graciam tuitionis et protectionis commisit" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-K000316> ;
        rf:role rv:Grantor ;
        rf:nameInSource "König Konrad III." ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-B000133:community> ;
        rf:role rv:Beneficiary ;
        rf:nameInSource "Bamberger Ministerialien" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Herzog Friedrichs von Schwaben" ] ;
    rf:concerns <urn:regesta:22654:right-schutz> ;
    rf:exception "non in ius advocatię" ;
    rf:refersToAct <urn:regesta:22654:uebergabe> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-7> ;
    rf:verificationStatus rv:unchecked .
