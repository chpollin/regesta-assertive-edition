# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1147-05-00_1_0_4_2_1_30_30

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22657> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 30" .

<urn:regesta:actor:RI004-002-W000272> a crm:E21_Person ;
    rdfs:label "Herzog Welf" .

<urn:regesta:actor:RI004-002-W000382:community> a crm:E74_Group ;
    rdfs:label "Kloster" .

<urn:regesta:22657:hoefe> a crm:E18_Physical_Thing ;
    rdfs:label "zweier Höfe" .

# The witness mention of Friedrich is the formulaic witness role of the Traditionsnotiz and is not extracted.

<urn:regesta:22657:transfer> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22657> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die Übergabe zweier Höfe an das Kloster durch Herzog Welf" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000272> ; rf:role rv:Grantor ; rf:nameInSource "Herzog Welf" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000382:community> ; rf:role rv:Recipient ; rf:nameInSource "Kloster" ] ;
    rf:concerns <urn:regesta:22657:hoefe> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-8> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22657:payment> a rf:ActFactoid ;
    rf:factoidType rv:Payment ;
    rf:source <urn:regesta:record:22657> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "durch Herzog Welf zum Inhalt hat, der dafür 10 Pfund erhält" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000272> ; rf:role rv:Payee ; rf:nameInSource "Herzog Welf" ] ;
    rf:amount "10 Pfund" ;
    rf:partOf <urn:regesta:22657:transfer> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-8> ;
    rf:verificationStatus rv:unchecked .
