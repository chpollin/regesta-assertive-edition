        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000801> ; rf:role rv:Petitioner ; rf:nameInSource "Bertrand" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G000337> ; rf:role rv:Petitioner ; rf:nameInSource "Gerbert" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000420> ; rf:role rv:Addressee ; rf:nameInSource "Abt Wibald von Stablo" ] ;
    rf:qualifier "weitere" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-45> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22810:treuegeloebnis> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22810> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "beim Kaiser (!), dem sie gegen die Angriffe des Grafen von Barcelona (Barcinonensis) Treue geloben" ] ,
