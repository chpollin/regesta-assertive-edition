<urn:regesta:22810:bitte> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22810> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Hugo von Baux und seine Brüder (Wilhelm , Bertrand und Gerbert ) danken Abt Wibald von Stablo" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "bitten ihn um weitere Unterstützung beim Kaiser (!)" ] ;
