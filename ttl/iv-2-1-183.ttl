    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001329> ; rf:role rv:Grantor ; rf:nameInSource "Hugo von Baux" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000573> ; rf:role rv:Grantor ; rf:nameInSource "Wilhelm" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000801> ; rf:role rv:Grantor ; rf:nameInSource "Bertrand" ] ,
