<urn:regesta:22810:brueder> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:22810> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Hugo von Baux und seine Brüder (Wilhelm , Bertrand und Gerbert )" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001329> ; rf:role rv:Kin ; rf:nameInSource "Hugo von Baux" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000573> ; rf:role rv:Kin ; rf:nameInSource "Wilhelm" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000801> ; rf:role rv:Kin ; rf:nameInSource "Bertrand" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G000337> ; rf:role rv:Kin ; rf:nameInSource "Gerbert" ] ;
    rf:qualifier "Brüder" ;
