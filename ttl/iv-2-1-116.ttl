<urn:regesta:22743:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22743> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "bestätigt ihnen ihre Besitzungen und Rechte vor allem am Westufer des Lago Maggiore und im Tale Ossola (Oxola)" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt die genannten Grafen von Castello (Mainfredum, Caualkasellam et fratres et Ardicionem et Crollamontem" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000332> ; rf:role rv:Recipient ; rf:nameInSource "Mainfredum" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-C000460> ; rf:role rv:Recipient ; rf:nameInSource "Caualkasellam" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22743:local:fratres> ; rf:role rv:Recipient ; rf:nameInSource "fratres" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A001108> ; rf:role rv:Recipient ; rf:nameInSource "Ardicionem" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-C001095> ; rf:role rv:Recipient ; rf:nameInSource "Crollamontem" ] ;
    rf:concerns <urn:regesta:22743:besitzungen> , <urn:regesta:22743:lago-maggiore> , <urn:regesta:22743:ossola> ;
    rf:qualifier "vor allem" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-28> ;
    rf:verificationStatus rv:unchecked .

