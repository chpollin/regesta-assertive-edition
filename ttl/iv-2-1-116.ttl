<urn:regesta:22743:predecessors-protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22743> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt die genannten Grafen von Castello (Mainfredum, Caualkasellam et fratres et Ardicionem et Crollamontem filios Wilielmi et Guidonis comites de Castello), wie seine Vorgänger Karl, Otto und Heinrich in seinen Schutz" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000079> ; rf:role rv:Grantor ; rf:nameInSource "Karl" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000396> ; rf:role rv:Grantor ; rf:nameInSource "Otto" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000359> ; rf:role rv:Grantor ; rf:nameInSource "Heinrich" ] ;
    rf:qualifier "wie seine Vorgänger" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-28> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22743:protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22743> ;
