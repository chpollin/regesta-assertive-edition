<urn:regesta:22743:berta-protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22743> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "nimmt auch die Eigengüter der Gattin Manfreds von Castello, Berta, in seinen Schutz" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt die genannten Grafen von Castello" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
