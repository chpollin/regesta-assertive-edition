# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-08-00_1_0_4_2_1_131_131

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22758> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 131" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-R000585> a crm:E21_Person ;
    rdfs:label "seine Cousine (Richildis)" .

<urn:regesta:22758:place-spanien> a crm:E53_Place ;
    rdfs:label "Spanien" .

<urn:regesta:22758:kinship-cousine> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:22758> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich entsendet seine Cousine (Richildis)" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
            rf:role rv:Kin ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000585> ;
            rf:role rv:Kin ; rf:nameInSource "seine Cousine (Richildis)" ] ;
    rf:qualifier "Cousine" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-32> ;
    rf:verificationStatus rv:unchecked .

# The sender has no role in the vocabulary; Participant is used (model gap). The betrothal to
# King Alfons VII. is not encoded, because the vocabulary has no betrothal type and a Marriage
# state would overreach (model gap).
<urn:regesta:22758:mission-spanien> a rf:ActFactoid ;
    rf:factoidType rv:Mission ;
    rf:source <urn:regesta:record:22758> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich entsendet seine Cousine (Richildis) , die mit König Alfons VII. von Kastilien (rege Hispanorum) verlobt ist, mit großem Gefolge nach Spanien." ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
            rf:role rv:Participant ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000585> ;
            rf:role rv:Envoy ; rf:nameInSource "seine Cousine (Richildis)" ] ;
    rf:concerns <urn:regesta:22758:place-spanien> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-32> ;
    rf:verificationStatus rv:unchecked .
