# Barbarossa-Regesten mit belegten Aussagen. Eine Agentic Edition auf Grundlage der Regesta Imperii IV,2
# Texte und Daten dieser Edition stehen unter CC BY 4.0, der Code unter MIT. Regesten und Register stammen aus Regesta Imperii Online (CC BY 4.0) und wurden bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-12-28_2_0_4_2_1_150_150

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22777> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-K000316> a crm:E21_Person ;
    rdfs:label "König Konrads (III.)" .

<urn:regesta:actor:RI004-002-F000201:community> a crm:E74_Group ;
    rdfs:label "Stift Floreffe" .

# Earlier act: the dispositions of King Konrad (III.), referred to by the protection, the clause in which the passage places it.
<urn:regesta:22777:konrad-dispositions> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22777> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "gemäß den Verfügungen König Konrads (III.)" ] ;
    rf:reference <urn:regesta:22777:konrad-dispositions:ref-konrad> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-37> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22777:konrad-dispositions:ref-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000316> ;
    rf:role rv:Grantor ;
    rf:nameInSource "König Konrads (III.)" .

# Main act: protection of Floreffe.
<urn:regesta:22777:protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22777> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt gemäß den Verfügungen König Konrads (III.) das Stift Floreffe in seinen Schutz" ] ;
    rf:reference <urn:regesta:22777:protection:ref-friedrich> , <urn:regesta:22777:protection:ref-floreffe> ;
    rf:refersToAct <urn:regesta:22777:konrad-dispositions> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-37> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22777:protection:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22777:protection:ref-floreffe> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000201:community> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Stift Floreffe" .

# Confirmation of the existing possessions.
<urn:regesta:22777:confirmation-possessions> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22777> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt gemäß den Verfügungen König Konrads (III.) das Stift Floreffe in seinen Schutz und bestätigt ihm den Besitzstand" ] ;
    rf:reference <urn:regesta:22777:confirmation-possessions:ref-friedrich> ,
        <urn:regesta:22777:confirmation-possessions:ref-floreffe> ;
    rf:concerns <urn:regesta:22777:thing-besitzstand> ;
    rf:partOf <urn:regesta:22777:protection> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22777:confirmation-possessions:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22777:confirmation-possessions:ref-floreffe> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000201:community> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Stift Floreffe" .

<urn:regesta:22777:thing-besitzstand> a crm:E18_Physical_Thing ;
    rdfs:label "den Besitzstand" .

# Confirmation of the right of free abbatial election.
<urn:regesta:22777:confirmation-abbot-election> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22777> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "das Stift Floreffe in seinen Schutz und bestätigt ihm den Besitzstand, das Recht der freien Abtwahl" ] ;
    rf:reference <urn:regesta:22777:confirmation-abbot-election:ref-friedrich> ,
        <urn:regesta:22777:confirmation-abbot-election:ref-floreffe> ;
    rf:concerns <urn:regesta:22777:right-abbot-election> ;
    rf:partOf <urn:regesta:22777:protection> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22777:confirmation-abbot-election:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22777:confirmation-abbot-election:ref-floreffe> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000201:community> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Stift Floreffe" .

<urn:regesta:22777:right-abbot-election> a crm:E30_Right ;
    crm:P2_has_type rv:ChurchRights ;
    rdfs:label "das Recht der freien Abtwahl" .

# Confirmation of the further possessions listed after "darüber hinaus".
<urn:regesta:22777:confirmation-further-possessions> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22777> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "bestätigt ihm den Besitzstand, das Recht der freien Abtwahl und darüber hinaus die Kirche von Leffe mit allem Zubehör (ecclesiam scilicet sancte Marie, que Leffle dicitur, cum omnibus attinentiis suis, scilicet prepositura, templi custodia, oblationibus altaris et prebendarum redditibus)" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "den Hof Fléchière (Fechire), die Hälfte des Allods von Mornimont (Mornigemont), die Höfe Marlange, Mariembourg (Uerofle) mit dem halben Zehent, Villers (Uileir), Coulonval (Ualle Columbina) und Eksel (Hecscele)" ] ;
    rf:reference <urn:regesta:22777:confirmation-further-possessions:ref-friedrich> ,
        <urn:regesta:22777:confirmation-further-possessions:ref-floreffe> ;
    rf:concerns <urn:regesta:22777:thing-church-leffe> ,
        <urn:regesta:22777:right-leffe-revenues> ,
        <urn:regesta:22777:thing-hof-flechiere> ,
        <urn:regesta:22777:thing-allod-mornimont-half> ,
        <urn:regesta:22777:thing-hof-marlange> ,
        <urn:regesta:22777:thing-hof-mariembourg> ,
        <urn:regesta:22777:right-mariembourg-half-tithe> ,
        <urn:regesta:22777:thing-hof-villers> ,
        <urn:regesta:22777:thing-hof-coulonval> ,
        <urn:regesta:22777:thing-hof-eksel> ;
    rf:qualifier "darüber hinaus" ;
    rf:partOf <urn:regesta:22777:protection> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g8> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22777:confirmation-further-possessions:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22777:confirmation-further-possessions:ref-floreffe> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000201:community> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Stift Floreffe" .

<urn:regesta:22777:thing-church-leffe> a crm:E18_Physical_Thing ;
    rdfs:label "die Kirche von Leffe mit allem Zubehör" .

<urn:regesta:22777:right-leffe-revenues> a crm:E30_Right ;
    crm:P2_has_type rv:Revenue ;
    rdfs:label "oblationibus altaris et prebendarum redditibus" .

<urn:regesta:22777:thing-hof-flechiere> a crm:E18_Physical_Thing ;
    rdfs:label "den Hof Fléchière (Fechire)" .

<urn:regesta:22777:thing-allod-mornimont-half> a crm:E18_Physical_Thing ;
    rdfs:label "die Hälfte des Allods von Mornimont (Mornigemont)" .

<urn:regesta:22777:thing-hof-marlange> a crm:E18_Physical_Thing ;
    rdfs:label "Marlange" .

<urn:regesta:22777:thing-hof-mariembourg> a crm:E18_Physical_Thing ;
    rdfs:label "Mariembourg (Uerofle)" .

<urn:regesta:22777:right-mariembourg-half-tithe> a crm:E30_Right ;
    crm:P2_has_type rv:Revenue ;
    rdfs:label "dem halben Zehent" .

<urn:regesta:22777:thing-hof-villers> a crm:E18_Physical_Thing ;
    rdfs:label "Villers (Uileir)" .

<urn:regesta:22777:thing-hof-coulonval> a crm:E18_Physical_Thing ;
    rdfs:label "Coulonval (Ualle Columbina)" .

<urn:regesta:22777:thing-hof-eksel> a crm:E18_Physical_Thing ;
    rdfs:label "Eksel (Hecscele)" .
