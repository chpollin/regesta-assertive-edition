# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-07-00_4_0_4_2_1_121_121

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22748> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 121" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-W000420> a crm:E21_Person ;
    rdfs:label "Abt Wibald von Corvey" .

<urn:regesta:actor:RI004-002-F000280> a crm:E21_Person ;
    rdfs:label "Folkwin" .

<urn:regesta:actor:RI004-002-W000454> a crm:E21_Person ;
    rdfs:label "Widekind von Schwalenberg" .

# The promise of revenge is an assurance; it does not establish that revenge was taken.
<urn:regesta:22748:promise-revenge> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22748> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich verspricht dem Abt Wibald von Corvey , er werde die ihm zugefügte Gewalttat (den Überfall der Brüder Folkwin und Widekind von Schwalenberg auf die Stadt Höxter) bei der nächsten sich bietenden Gelegenheit rächen" ] ;
    rf:reference <urn:regesta:22748:ref-promise-friedrich> ,
        <urn:regesta:22748:ref-promise-wibald> ,
        <urn:regesta:22748:ref-promise-folkwin> ,
        <urn:regesta:22748:ref-promise-widekind> ;
    rf:qualifier "bei der nächsten sich bietenden Gelegenheit" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-30> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22748:ref-promise-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22748:ref-promise-wibald> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-W000420> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Abt Wibald von Corvey" .

# The perpetrators of the wrong to be avenged have no dedicated role; Participant is used (model gap).
<urn:regesta:22748:ref-promise-folkwin> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000280> ;
    rf:role rv:Participant ;
    rf:nameInSource "Folkwin" .

<urn:regesta:22748:ref-promise-widekind> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-W000454> ;
    rf:role rv:Participant ;
    rf:nameInSource "Widekind von Schwalenberg" .

<urn:regesta:22748:brothers> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:22748> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Brüder Folkwin und Widekind von Schwalenberg" ] ;
    rf:reference <urn:regesta:22748:ref-brothers-folkwin> ,
        <urn:regesta:22748:ref-brothers-widekind> ;
    rf:qualifier "Brüder" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-30> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22748:ref-brothers-folkwin> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000280> ;
    rf:role rv:Kin ;
    rf:nameInSource "Folkwin" .

<urn:regesta:22748:ref-brothers-widekind> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-W000454> ;
    rf:role rv:Kin ;
    rf:nameInSource "Widekind von Schwalenberg" .
