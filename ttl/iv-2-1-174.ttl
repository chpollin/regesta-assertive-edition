# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1153-04-24_1_0_4_2_1_174_174

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22801> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-A001103> a crm:E21_Person ;
    rdfs:label "Bischof Ardicio von Como" .

<urn:regesta:22801:hoheitsrechte> a crm:E30_Right ;
    crm:P2_has_type rv:LordshipRights ;
    rdfs:label "die Hoheitsrechte (honorem, districtum)" .

<urn:regesta:22801:fodrum> a crm:E30_Right ;
    crm:P2_has_type rv:Revenue ;
    rdfs:label "das Fodrum" .

<urn:regesta:22801:regalien> a crm:E30_Right ;
    crm:P2_has_type rv:LordshipRights ;
    rdfs:label "allen Regalien" .

<urn:regesta:22801:gravedona> a crm:E53_Place ;
    rdfs:label "Gravedona" .

<urn:regesta:22801:domaso> a crm:E53_Place ;
    rdfs:label "Domaso" .

<urn:regesta:22801:donation> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22801> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich schenkt dem Bischof Ardicio von Como die Hoheitsrechte (honorem, districtum) und das Fodrum mit allen Regalien zu Gravedona und Domaso" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-A001103> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Bischof Ardicio von Como" ] ;
    rf:concerns <urn:regesta:22801:hoheitsrechte> , <urn:regesta:22801:fodrum> , <urn:regesta:22801:regalien> ,
        <urn:regesta:22801:gravedona> , <urn:regesta:22801:domaso> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-43> ;
    rf:verificationStatus rv:unchecked .
