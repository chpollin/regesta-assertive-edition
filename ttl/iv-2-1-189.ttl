<urn:regesta:22816:request> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22816> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Bischof Stephan von Metz bittet Abt Wibald von Stablo , daß er den König veranlassen möge, das ihm und der Kirche zugefügte Unrecht, das auch durch die Vermittlung Abt Bernhards von Clairvaux nicht aus der Welt geschafft sei, zu beseitigen" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S001143> ; rf:role rv:Petitioner ; rf:nameInSource "Bischof Stephan von Metz" ] ,
