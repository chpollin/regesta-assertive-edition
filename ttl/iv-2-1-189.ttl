    rf:refersToAct <urn:regesta:22816:dispute-unrecht> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g10> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22816:dispute-unrecht> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22816> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "das ihm und der Kirche zugefügte Unrecht, das auch durch die Vermittlung Abt Bernhards von Clairvaux nicht aus der Welt geschafft sei" ] ;
