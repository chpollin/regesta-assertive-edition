# Barbarossa-Regesten. Ein Experiment mit LLM-Agenten auf Grundlage der Regesta Imperii IV,2
# Texte und Daten CC BY 4.0, Code MIT. Regesten und Register aus Regesta Imperii Online (CC BY 4.0), bearbeitet.
# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1147-01-04_1_0_4_2_1_20_20

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22647> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 20" .

<urn:regesta:actor:RI004-002-A000549> a crm:E21_Person ;
    rdfs:label "Erzbischof Adalbero von Trier" .

<urn:regesta:actor:RI004-002-H000540> a crm:E21_Person ;
    rdfs:label "Graf Heinrich von Namur" .

# The regest names no claimant or respondent ("zwischen"), so both parties are Participants.
# The settlement ("Beilegung") has no act type in the contract and is not recorded (model gap).
# Friedrich, Herzog von Schwaben, appears only as charter witness of the settlement, which falls
# under the excluded formulaic witness mentions; his identity is also unresolved (batch report).
<urn:regesta:22647:dispute-adalbero-heinrich> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22647> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Streites zwischen Erzbischof Adalbero von Trier und Graf Heinrich von Namur" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000549> ;
            rf:role rv:Participant ; rf:nameInSource "Erzbischof Adalbero von Trier" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000540> ;
            rf:role rv:Participant ; rf:nameInSource "Graf Heinrich von Namur" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-5> ;
    rf:verificationStatus rv:unchecked .
