    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-35> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22770:grant-bannforst> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22770> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "verbrieft ihm den Bannforst Virgunda in den angegebenen Grenzen" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "der König" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22770:local:kloster-ellwangen> ; rf:role rv:Recipient ; rf:nameInSource "ihm" ] ;
