    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-35> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22770:enactment-vogtei> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22770> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "trifft folgende Bestimmungen über die Vogtei" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ;
    rf:concerns <urn:regesta:22770:vogtei> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-35> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22770:provision-gericht> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:partOf <urn:regesta:22770:enactment-vogtei> ;
    rf:source <urn:regesta:record:22770> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Der Vogt darf nur dreimal im Jahr mit zwölf Berittenen im Kloster Gericht halten und dabei seine Einkünfte (suum servitium videlicet duas victimas cum suis appenditiis) empfangen" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:22770:local:vogt> ; rf:role rv:Obligor ; rf:nameInSource "Der Vogt" ] ;
    rf:concerns <urn:regesta:22770:gericht> , <urn:regesta:22770:einkuenfte> ;
    rf:qualifier "nur dreimal im Jahr mit zwölf Berittenen" ;
    rf:amount "duas victimas cum suis appenditiis" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-35> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22770:provision-taetigkeit> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:partOf <urn:regesta:22770:enactment-vogtei> ;
    rf:source <urn:regesta:record:22770> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "darüber hinaus darf er nur auf Wunsch des Abtes tätig werden" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:22770:local:vogt> ; rf:role rv:Obligor ; rf:nameInSource "er" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22770:local:abt> ; rf:role rv:Participant ; rf:nameInSource "des Abtes" ] ;
    rf:concerns <urn:regesta:22770:vogtei> ;
    rf:condition "nur auf Wunsch des Abtes" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-35> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22770:grant-recht-fulda-reichenau> a rf:ActFactoid ;
    rf:factoidType rv:RightGrant ;
    rf:source <urn:regesta:record:22770> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "überträgt der König dem Kloster das Recht der Abteien Fulda und Reichenau" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "der König" ] ,
