<urn:regesta:22770:protection> a rf:ActFactoid ;
    rf:factoidType rv:ProtectionGrant ;
    rf:source <urn:regesta:record:22770> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich nimmt auf Bitten seines Kanzlers Arnold und anderer Fürsten Abt Adalbert von Ellwangen mit seinem Kloster (abbatia ... Elwanc nominata in honore sanctorum martirum Viti, Sulpitii et Seruiliani dedicata) in seinen Schutz" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A001203> ; rf:role rv:Petitioner ; rf:nameInSource "seines Kanzlers Arnold" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22770:local:andere-fuersten> ; rf:role rv:Petitioner ; rf:nameInSource "anderer Fürsten" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000100> ; rf:role rv:Recipient ; rf:nameInSource "Abt Adalbert von Ellwangen" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22770:local:kloster-ellwangen> ; rf:role rv:Recipient ; rf:nameInSource "seinem Kloster" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-35> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22770:confirmation-besitzstand> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22770> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "bestätigt ihm den Besitzstand" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000100> ; rf:role rv:Recipient ; rf:nameInSource "ihm" ] ;
