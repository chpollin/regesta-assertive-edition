<urn:regesta:record:22803> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-J000146> a crm:E21_Person ;
    rdfs:label "'Bruders' Johannes (des Stiftsverwalters)" .

