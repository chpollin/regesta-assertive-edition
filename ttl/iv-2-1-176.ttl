<urn:regesta:22803:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22803> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich bestätigt auf Bitten des 'Bruders' Johannes (des Stiftsverwalters) dem Stift Fredelsloh (cenobium Fridessele) in Erneuerung der Verfügungen Konrads (III.)" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "als Seelgerät die dem Reich gehörige Kapelle Grone, den Königsschutz, die ausschließliche Unterstellung unter die königliche Vogtei (ne advocatum aliquem preter nos nostrosque successores reges seu imperatores predictus locus habeat)" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-J000146> ;
        rf:role rv:Petitioner ;
        rf:nameInSource "Johannes" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000421:community> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Stift Fredelsloh" ] ;
    rf:concerns <urn:regesta:22803:kapelle-grone> , <urn:regesta:22803:koenigsschutz> , <urn:regesta:22803:koenigliche-vogtei> ;
    rf:refersToAct <urn:regesta:22803:konrad-verfuegungen> ;
    rf:qualifier "als Seelgerät" , "in Erneuerung" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-43> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22803:grone-reich> a rf:StateFactoid ;
    rf:factoidType rv:Possession ;
    rf:source <urn:regesta:record:22803> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die dem Reich gehörige Kapelle Grone" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:22803:local:reich> ;
        rf:role rv:Possessor ;
        rf:nameInSource "Reich" ] ;
    rf:concerns <urn:regesta:22803:kapelle-grone> ;
