<urn:regesta:actor:22803:local:reich> a crm:E74_Group ;
    rdfs:label "Reich" .

<urn:regesta:22803:kapelle-grone> a crm:E18_Physical_Thing ;
    rdfs:label "die dem Reich gehörige Kapelle Grone" .

<urn:regesta:22803:koenigsschutz> a crm:E30_Right ;
    crm:P2_has_type rv:Protection ;
    rdfs:label "den Königsschutz" .

<urn:regesta:22803:koenigliche-vogtei> a crm:E30_Right ;
    crm:P2_has_type rv:Advocacy ;
    rdfs:label "die ausschließliche Unterstellung unter die königliche Vogtei" .

<urn:regesta:22803:hufen> a crm:E18_Physical_Thing ;
    rdfs:label "zweier Hufen mit dem Ertrag von 20 Solidi" .

<urn:regesta:22803:muehle> a crm:E18_Physical_Thing ;
    rdfs:label "einer Mühle mit 4 Solidi Ertrag" .

<urn:regesta:22803:rossdorf> a crm:E53_Place ;
    rdfs:label "Roßdorf" .

<urn:regesta:22803:konrad-verfuegungen> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22803> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Verfügungen Konrads (III.)" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-K000316> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Konrads (III.)" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-43> ;
