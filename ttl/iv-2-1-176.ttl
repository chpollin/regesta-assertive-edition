    rf:verificationStatus rv:unchecked .

<urn:regesta:22803:donation> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22803> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "fügt selber die Schenkung zweier Hufen mit dem Ertrag von 20 Solidi, sowie einer Mühle mit 4 Solidi Ertrag in Roßdorf" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "dem Stift Fredelsloh (cenobium Fridessele)" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000421:community> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Stift Fredelsloh" ] ;
    rf:concerns <urn:regesta:22803:hufen> , <urn:regesta:22803:muehle> , <urn:regesta:22803:rossdorf> ;
    rf:amount "mit dem Ertrag von 20 Solidi" , "mit 4 Solidi Ertrag" ;
    rf:qualifier "selber" ;
    rf:partOf <urn:regesta:22803:confirmation> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-43> ;
