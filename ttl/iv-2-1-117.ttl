# Lauf factoid-1153-2026-11-11, Stand revised. Bearbeitet. Markup in Klartext überführt, Regest ausgewählt und verknüpft, Aussagen von LLM-basierten Agenten aus dem Regesttext erzeugt. Die Aussagen sind keine Aussagen der Regesta Imperii.
# Quelle: https://www.regesta-imperii.de/id/1152-08-01_1_0_4_2_1_117_117

@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22744> a crm:E31_Document .

# Actors

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-G001142> a crm:E21_Person ; rdfs:label "Wibert" .
<urn:regesta:actor:RI004-002-S000901> a crm:E21_Person ; rdfs:label "Soldanus" .
<urn:regesta:actor:RI004-002-A000146> a crm:E21_Person ; rdfs:label "Albert von Kiburg (Chiburch)" .
<urn:regesta:actor:RI004-002-A001103> a crm:E21_Person ; rdfs:label "Bischof Ardicio von Como" .
<urn:regesta:actor:RI004-002-H000542> a crm:E21_Person ; rdfs:label "Henricus de Hostia" .
<urn:regesta:actor:22744:local:dortige-konsuln> a rf:FunctionalActor ; rdfs:label "die dortigen Konsuln" .

# Things and rights

<urn:regesta:22744:grafschaft-chiavenna> a crm:E53_Place ; rdfs:label "Grafschaft Chiavenna" .
<urn:regesta:22744:koenigliches-recht> a crm:E30_Right ;
    crm:P2_has_type rv:LordshipRights ;
    rdfs:label "des königlichen Rechts" .

# Enfeoffment of the consuls

<urn:regesta:22744:enfeoffment> a rf:ActFactoid ;
    rf:factoidType rv:Enfeoffment ;
    rf:source <urn:regesta:record:22744> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich belehnt die Konsuln Wibert und Soldanus von Chiavenna (Clavennates)" ] ,
                [ a oa:TextQuoteSelector ; oa:exact "vorbehaltlich des königlichen Rechts mit der genannten Grafschaft" ] ;
    rf:reference <urn:regesta:22744:enfeoffment:ref-friedrich> ,
                 <urn:regesta:22744:enfeoffment:ref-wibert> ,
                 <urn:regesta:22744:enfeoffment:ref-soldanus> ;
    rf:concerns <urn:regesta:22744:grafschaft-chiavenna> ;
    rf:ground "auf Grund eines von Albert von Kiburg (Chiburch) gefundenen Fürstenspruches" ;
    rf:exception "vorbehaltlich des königlichen Rechts" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-29> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22744:enfeoffment:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" .
<urn:regesta:22744:enfeoffment:ref-wibert> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-G001142> ; rf:role rv:Recipient ; rf:nameInSource "Wibert" .
<urn:regesta:22744:enfeoffment:ref-soldanus> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-S000901> ; rf:role rv:Recipient ; rf:nameInSource "Soldanus" .

# Reservation of the royal right, a provision of the enfeoffment

<urn:regesta:22744:reservation> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22744> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "vorbehaltlich des königlichen Rechts mit der genannten Grafschaft" ] ;
    rf:partOf <urn:regesta:22744:enfeoffment> ;
    rf:concerns <urn:regesta:22744:koenigliches-recht> , <urn:regesta:22744:grafschaft-chiavenna> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-29> ;
    rf:verificationStatus rv:unchecked .

# Judgment of the princes found by Albert von Kiburg

<urn:regesta:22744:princes-judgment> a rf:ActFactoid ;
    rf:factoidType rv:Judgment ;
    rf:source <urn:regesta:record:22744> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "eines von Albert von Kiburg (Chiburch) gefundenen Fürstenspruches" ] ;
    rf:reference <urn:regesta:22744:princes-judgment:ref-albert> ;
    rf:concerns <urn:regesta:22744:grafschaft-chiavenna> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-29> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22744:princes-judgment:ref-albert> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-A000146> ; rf:role rv:Judge ; rf:nameInSource "Albert von Kiburg (Chiburch)" .

# Possession of the county by the consuls, as the judgment emphasises it

<urn:regesta:22744:consuls-possession> a rf:StateFactoid ;
    rf:factoidType rv:Possession ;
    rf:source <urn:regesta:record:22744> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Fürstenspruches, der den durch 30 Jahre hindurch ununterbrochenen Besitz der Grafschaft Chiavenna durch die dortigen Konsuln" ] ;
    rf:reference <urn:regesta:22744:consuls-possession:ref-konsuln> ;
    rf:concerns <urn:regesta:22744:grafschaft-chiavenna> ;
    rf:qualifier "durch 30 Jahre hindurch ununterbrochenen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-29> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22744:consuls-possession:ref-konsuln> a rf:Reference ;
    rf:actor <urn:regesta:actor:22744:local:dortige-konsuln> ; rf:role rv:Possessor ; rf:nameInSource "die dortigen Konsuln" .

# Claims to the county by Bishop Ardicio and Henricus de Hostia

<urn:regesta:22744:county-claims> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22744> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "auf die sowohl Bischof Ardicio von Como als auch Henricus de Hostia Anspruch erhoben haben" ] ;
    rf:reference <urn:regesta:22744:county-claims:ref-ardicio> ,
                 <urn:regesta:22744:county-claims:ref-henricus> ;
    rf:concerns <urn:regesta:22744:grafschaft-chiavenna> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-29> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22744:county-claims:ref-ardicio> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-A001103> ; rf:role rv:Claimant ; rf:nameInSource "Bischof Ardicio von Como" .
<urn:regesta:22744:county-claims:ref-henricus> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-H000542> ; rf:role rv:Claimant ; rf:nameInSource "Henricus de Hostia" .
