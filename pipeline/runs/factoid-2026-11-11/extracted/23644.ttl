@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:23644> a crm:E31_Document ;
    rdfs:label "RI IV,2,2 n. 1015" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-K000399> a crm:E21_Person ;
    rdfs:label "Pfalzgraf Konrad bei Rhein" .

# No register candidate in this packet names Wido.
<urn:regesta:actor:23644:local:wido-von-biandrate> a crm:E21_Person ;
    rdfs:label "Grafen Wido von Biandrate" .

<urn:regesta:actor:23644:local:reich> a crm:E74_Group ;
    rdfs:label "Reich" .

<urn:regesta:23644:possessions-canale> a crm:E18_Physical_Thing ;
    rdfs:label "die genannten Besitzungen im Tal von Canale" .

<urn:regesta:23644:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:23644> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich bestätigt, daß sein Bruder, Pfalzgraf Konrad bei Rhein, dem Grafen Wido von Biandrate die genannten Besitzungen im Tal von Canale, die er selbst vom Reich zu Lehen trägt, als erbliche Lehen verliehen hat" ] ;
    rf:reference <urn:regesta:23644:confirmation-ref-friedrich> , <urn:regesta:23644:confirmation-ref-wido> ;
    rf:refersToAct <urn:regesta:23644:enfeoffment> ;
    rf:concerns <urn:regesta:23644:possessions-canale> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:23644:confirmation-ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:23644:confirmation-ref-wido> a rf:Reference ;
    rf:actor <urn:regesta:actor:23644:local:wido-von-biandrate> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Grafen Wido von Biandrate" .

# The earlier enfeoffment by Konrad; the regest gives it no date.
<urn:regesta:23644:enfeoffment> a rf:ActFactoid ;
    rf:factoidType rv:Enfeoffment ;
    rf:source <urn:regesta:record:23644> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Pfalzgraf Konrad bei Rhein, dem Grafen Wido von Biandrate die genannten Besitzungen im Tal von Canale, die er selbst vom Reich zu Lehen trägt, als erbliche Lehen verliehen hat" ] ;
    rf:reference <urn:regesta:23644:enfeoffment-ref-konrad> , <urn:regesta:23644:enfeoffment-ref-wido> ;
    rf:concerns <urn:regesta:23644:possessions-canale> ;
    rf:qualifier "als erbliche Lehen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:23644:enfeoffment-ref-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000399> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Pfalzgraf Konrad bei Rhein" .

<urn:regesta:23644:enfeoffment-ref-wido> a rf:Reference ;
    rf:actor <urn:regesta:actor:23644:local:wido-von-biandrate> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Grafen Wido von Biandrate" .

<urn:regesta:23644:kinship-friedrich-konrad> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:23644> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich bestätigt, daß sein Bruder, Pfalzgraf Konrad bei Rhein" ] ;
    rf:reference <urn:regesta:23644:kinship-ref-friedrich> , <urn:regesta:23644:kinship-ref-konrad> ;
    rf:qualifier "Bruder" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:23644:kinship-ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Kin ;
    rf:nameInSource "Friedrich" .

<urn:regesta:23644:kinship-ref-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000399> ;
    rf:role rv:Kin ;
    rf:nameInSource "Pfalzgraf Konrad bei Rhein" .

# "er selbst" is read as Konrad, the grammatical subject of the enfeoffment clause.
<urn:regesta:23644:fief-konrad> a rf:StateFactoid ;
    rf:factoidType rv:FeudalRelationship ;
    rf:source <urn:regesta:record:23644> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die genannten Besitzungen im Tal von Canale, die er selbst vom Reich zu Lehen trägt" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Pfalzgraf Konrad bei Rhein, dem Grafen Wido" ] ;
    rf:reference <urn:regesta:23644:fief-ref-konrad> , <urn:regesta:23644:fief-ref-reich> ;
    rf:concerns <urn:regesta:23644:possessions-canale> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:23644:fief-ref-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000399> ;
    rf:role rv:Vassal ;
    rf:nameInSource "Pfalzgraf Konrad bei Rhein" .

<urn:regesta:23644:fief-ref-reich> a rf:Reference ;
    rf:actor <urn:regesta:actor:23644:local:reich> ;
    rf:role rv:Lord ;
    rf:nameInSource "Reich" .
