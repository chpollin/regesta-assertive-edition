<urn:regesta:record:25897> a crm:E31_Document ;
    rdfs:label "RI IV,2,4 n. 3077" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Kaiser (Friedrichs)" .

# The register offers only a collective sub-entry for envoys of the emperor (RI004-002-F000473), not an individual.
<urn:regesta:actor:25897:local:bote> a rf:FunctionalActor ;
    rdfs:label "Ein Bote Kaiser (Friedrichs)" .

<urn:regesta:actor:RI004-002-K000396> a crm:E21_Person ;
    rdfs:label "Herzog Konrad von Rothenburg" .

<urn:regesta:actor:RI004-002-B000546> a crm:E21_Person ;
    rdfs:label "Berengaria" .

<urn:regesta:actor:RI004-002-A000647> a crm:E21_Person ;
    rdfs:label "König Alfons’ (VIII.) von Kastilien" .

# A negotiation about a marriage; no marriage is concluded.
<urn:regesta:25897:negotiation> a rf:ActFactoid ;
    rf:factoidType rv:Negotiation ;
    rf:source <urn:regesta:record:25897> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Ein Bote Kaiser (Friedrichs) weilt am Hofe König Alfons’ (VIII.) von Kastilien und verhandelt über eine Heirat zwischen dem Sohn des Kaisers (Herzog Konrad von Rothenburg) und der Tochter (Berengaria) des kastilischen Königs (Alfons’ VIII.)" ] ;
    rf:reference <urn:regesta:25897:negotiation-ref-bote> ,
        <urn:regesta:25897:negotiation-ref-kaiser> ,
        <urn:regesta:25897:negotiation-ref-konrad> ,
        <urn:regesta:25897:negotiation-ref-berengaria> ;
    rf:qualifier "eine Heirat" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-2> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:25897:negotiation-ref-bote> a rf:Reference ;
    rf:actor <urn:regesta:actor:25897:local:bote> ;
    rf:role rv:Negotiator ;
    rf:nameInSource "Ein Bote Kaiser (Friedrichs)" .

