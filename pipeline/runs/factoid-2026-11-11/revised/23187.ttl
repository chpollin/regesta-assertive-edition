# The campaign and the list of its participants are military movement and stay out of scope.

<urn:regesta:record:23187> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 558" .

# Actors

<urn:regesta:actor:RI004-002-T000161> a crm:E21_Person ;
    rdfs:label "Herzog Theobald von Böhmen" .

# No register candidate for Vladislav in this packet.
<urn:regesta:actor:23187:local:vladislav> a crm:E21_Person ;
    rdfs:label "König Vladislavs" .

<urn:regesta:actor:23187:local:lombarden> a crm:E74_Group ;
    rdfs:label "Lombarden" .

<urn:regesta:actor:RI004-002-M000086:community> a crm:E74_Group ;
    rdfs:label "Mailand" .

# Brother relation

<urn:regesta:23187:kinship-theobald-vladislav> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:23187> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Herzog Theobald von Böhmen, der Bruder König Vladislavs" ] ;
    rf:reference <urn:regesta:23187:kinship-ref-theobald> , <urn:regesta:23187:kinship-ref-vladislav> ;
    rf:qualifier "Bruder" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-1> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:23187:kinship-ref-theobald> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-T000161> ;
    rf:role rv:Kin ;
    rf:nameInSource "Herzog Theobald von Böhmen" .

<urn:regesta:23187:kinship-ref-vladislav> a rf:Reference ;
    rf:actor <urn:regesta:actor:23187:local:vladislav> ;
    rf:role rv:Kin ;
    rf:nameInSource "König Vladislavs" .

# Complaint of the Lombards about Milan

<urn:regesta:23187:complaint-lombarden> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:23187> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "gegen Mailand gerichtet ist, über das die unterdrückten Lombarden Klage geführt haben" ] ;
    rf:reference <urn:regesta:23187:complaint-ref-lombarden> , <urn:regesta:23187:complaint-ref-mailand> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-1> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:23187:complaint-ref-lombarden> a rf:Reference ;
    rf:actor <urn:regesta:actor:23187:local:lombarden> ;
    rf:role rv:Claimant ;
    rf:nameInSource "Lombarden" .

<urn:regesta:23187:complaint-ref-mailand> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-M000086:community> ;
    rf:role rv:Respondent ;
    rf:nameInSource "Mailand" .
