@prefix rf: <https://example.org/regesta/factoid/> .
@prefix rv: <https://example.org/regesta/concept/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22794> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-A000547> a crm:E21_Person ; rdfs:label "Albernardus Alamanus" .
<urn:regesta:actor:RI004-002-H001179> a crm:E21_Person ; rdfs:label "Magister Homobonus" .
<urn:regesta:actor:RI004-002-M000144:community> a crm:E74_Group ; rdfs:label "die Mailänder" .
<urn:regesta:actor:22794:local:fuersten> a crm:E74_Group ; rdfs:label "den Fürsten" .
<urn:regesta:actor:RI004-002-A001203> a crm:E21_Person ; rdfs:label "Kanzler (Arnold)" .
<urn:regesta:actor:RI004-002-A000306> a crm:E21_Person ; rdfs:label "Adela" .
<urn:regesta:actor:RI004-002-T000163> a crm:E21_Person ; rdfs:label "Markgrafen Diepold von Vohburg" .
<urn:regesta:actor:RI004-002-B000622> a crm:E21_Person ; rdfs:label "Kardinalpriestcr Bernhard von S. Clemente" .
<urn:regesta:actor:RI004-002-G000973> a crm:E21_Person ; rdfs:label "Kardinaldiakon Gregor von S. Angelo" .
<urn:regesta:actor:RI004-002-H000817> a crm:E21_Person ; rdfs:label "Bischof Hermann von Konstanz" .

# Complaint of the two citizens of Lodi before the king and the princes.
<urn:regesta:22794:complaint> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22794> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Die beiden Bürger von Lodi, Albernardus Alamanus und Magister Homobonus" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "klagen vor König Friedrich und den Fürsten über die Unterdrückung durch die Mailänder, besonders über die gewaltsame Verlegung eines Marktes" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000547> ; rf:role rv:Claimant ; rf:nameInSource "Albernardus Alamanus" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001179> ; rf:role rv:Claimant ; rf:nameInSource "Magister Homobonus" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000144:community> ; rf:role rv:Respondent ; rf:nameInSource "Mailänder" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Addressee ; rf:nameInSource "König Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22794:local:fuersten> ; rf:role rv:Addressee ; rf:nameInSource "Fürsten" ] ;
    rf:concerns <urn:regesta:22794:market> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-5> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22794:market> a crm:E30_Right ;
    crm:P2_has_type rv:Market ;
    rdfs:label "eines Marktes" .

# Letter to the Milanese issued through the chancellor in response to the complaint.
<urn:regesta:22794:letter> a rf:ActFactoid ;
    rf:factoidType rv:Communication ;
    rf:source <urn:regesta:record:22794> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "worauf Friedrich durch seinen Kanzler (Arnold) ein Schreiben an die Mailänder ausfertigen läßt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A001203> ; rf:role rv:Representative ; rf:nameInSource "Kanzler (Arnold)" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000144:community> ; rf:role rv:Addressee ; rf:nameInSource "Mailänder" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-5> ;
    rf:verificationStatus rv:unchecked .

# Divorce of Friedrich and Adela; the legates and the bishop are present, not given a judging role.
<urn:regesta:22794:divorce> a rf:ActFactoid ;
    rf:factoidType rv:MarriageDissolution ;
    rf:source <urn:regesta:record:22794> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "vor den päpstlichen Legaten und Bischof Hermann von Konstanz von Adela, seiner ersten Gemahlin, der Tochter des Markgrafen Diepold von Vohburg, wegen zu naher Verwandtschaft im Chor (des Domes) von Konstanz geschieden" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich wird" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Spouse ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000306> ; rf:role rv:Spouse ; rf:nameInSource "Adela" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000622> ; rf:role rv:Participant ; rf:nameInSource "päpstlichen Legaten" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G000973> ; rf:role rv:Participant ; rf:nameInSource "päpstlichen Legaten" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000817> ; rf:role rv:Participant ; rf:nameInSource "Bischof Hermann von Konstanz" ] ;
    rf:ground "zu naher Verwandtschaft" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-5> ;
    rf:verificationStatus rv:unchecked .

# The marriage that the divorce dissolves, as the regest names it.
<urn:regesta:22794:marriage> a rf:StateFactoid ;
    rf:factoidType rv:Marriage ;
    rf:source <urn:regesta:record:22794> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "von Adela, seiner ersten Gemahlin" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000306> ; rf:role rv:Spouse ; rf:nameInSource "Adela" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Spouse ; rf:nameInSource "seiner" ] ;
    rf:qualifier "ersten Gemahlin" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-5> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22794:parenthood-adela> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:source <urn:regesta:record:22794> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Adela, seiner ersten Gemahlin, der Tochter des Markgrafen Diepold von Vohburg" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-T000163> ; rf:role rv:Parent ; rf:nameInSource "Markgrafen Diepold von Vohburg" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000306> ; rf:role rv:Child ; rf:nameInSource "Adela" ] ;
    rf:qualifier "Tochter" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-2026-11-11:extraction-batch-5> ;
    rf:verificationStatus rv:unchecked .
