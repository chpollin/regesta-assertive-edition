<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-E000011> a crm:E21_Person ; rdfs:label "Bischof Eberhard II. von Bamberg" .
<urn:regesta:22696:donation> a crm:E7_Activity ; crm:P2_has_type v:Donation ; crm:P3_has_note "Reichsabtei Niederaltaich an den Bischof, seine Nachfolger und seine Kirche auf dessen Bitten." ; crm:P14_carried_out_by <urn:regesta:actor:RI004-002-F000471> ; reg:exception "wobei dem Abt und den Mönchen ihre Einkünfte (stipendia) aber unvermindert erhalten bleiben sollen" .
<urn:regesta:22696:a1> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:22696:donation> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:Donation ; reg:source <urn:regesta:record:22696> ; reg:evidence "Friedrich schenkt zu seinem und seines in der Domkirche zu Bamberg beigesetzten Oheims und Vorgängers, König Konrad III., ewigem Angedenken auf Bitten Bischof Eberhards II. von Bamberg diesem, seinen Nachfolgern und seiner Kirche zur Hebung des religiösen Lebens die in weltlicher und geistlicher Hinsicht in trostlosem Zustand befindliche Reichsabtei Niederaltaich" .
<urn:regesta:22696:a2> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:22696:donation> ; crm:P177_assigned_property_of_type crm:P14_carried_out_by ; crm:P141_assigned <urn:regesta:actor:RI004-002-F000471> ; reg:source <urn:regesta:record:22696> ; reg:evidence "Friedrich schenkt" .
