<urn:regesta:22696:a3> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:22696:recipient> ; crm:P177_assigned_property_of_type reg:role ; crm:P141_assigned v:Recipient ; reg:source <urn:regesta:record:22696> ; reg:evidence "auf Bitten Bischof Eberhards II. von Bamberg diesem, seinen Nachfolgern und seiner Kirche" .
<urn:regesta:22696:investiture> a crm:E30_Right ; crm:P2_has_type v:InvestitureRight ; rdfs:label "Recht der Investitur des Abtes" .
<urn:regesta:22696:a4> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:22696:investiture> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:InvestitureRight ; reg:source <urn:regesta:record:22696> ; reg:evidence "Der Bischof oder sein kanonisch gewählter Nachfolger hat das Recht der Investitur des Abtes" .
