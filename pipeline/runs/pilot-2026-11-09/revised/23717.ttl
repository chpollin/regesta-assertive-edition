<urn:regesta:record:23717> a crm:E31_Document .
<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-C000861:community> a crm:E74_Group ; rdfs:label "Kirche von Como" .
<urn:regesta:actor:RI004-002-H000386> a crm:E21_Person ; rdfs:label "Bischof H(einrich)" .
<urn:regesta:23717:release> a crm:E7_Activity ; crm:P2_has_type v:DebtRelease ; crm:P14_carried_out_by <urn:regesta:actor:RI004-002-F000471> ; reg:exception "außer von denen, die nachweislich im Dienst des Reiches oder zum Nutzen der Kirche eingegangen wurden" ; crm:P3_has_note "von allen Wucherzinsen und Zahlungsverpflichtungen" .
<urn:regesta:23717:beneficiary> a reg:Participation ; reg:context <urn:regesta:23717:release> ; reg:actor <urn:regesta:actor:RI004-002-C000861:community> ; reg:role v:Beneficiary .
<urn:regesta:23717:restitution> a crm:E7_Activity ; crm:P2_has_type v:Restitution ; crm:P14_carried_out_by <urn:regesta:actor:RI004-002-F000471> ; crm:P3_has_note "alle Besitzungen, die sein Vorgänger innehatte" .
<urn:regesta:23717:recipient> a reg:Participation ; reg:context <urn:regesta:23717:restitution> ; reg:actor <urn:regesta:actor:RI004-002-H000386> ; reg:role v:Recipient .
<urn:regesta:23717:revocation> a crm:E7_Activity ; crm:P2_has_type v:Revocation ; crm:P14_carried_out_by <urn:regesta:actor:RI004-002-F000471> ; crm:P3_has_note "die Vergabe von Lehen, die dieser in den letzten acht Tagen vor seinem Tod durchführte" .
<urn:regesta:23717:a1> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:23717:release> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:DebtRelease ; reg:source <urn:regesta:record:23717> ; reg:evidence "Friedrich erklärt die unter dem verstorbenen Bischof Ardicio schwer verschuldete Kirche von Como von allen Wucherzinsen und Zahlungsverpflichtungen ledig, außer von denen, die nachweislich im Dienst des Reiches oder zum Nutzen der Kirche eingegangen wurden" .
<urn:regesta:23717:a2> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:23717:restitution> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:Restitution ; reg:source <urn:regesta:record:23717> ; reg:evidence "stellt dem Bischof H(einrich) alle Besitzungen zurück, die sein Vorgänger innehatte" .
<urn:regesta:23717:a3> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:23717:revocation> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:Revocation ; reg:source <urn:regesta:record:23717> ; reg:evidence "widerruft die Vergabe von Lehen, die dieser in den letzten acht Tagen vor seinem Tod durchführte" .
