@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix reg: <https://example.org/regesta/ontology/> .
@prefix v: <https://example.org/regesta/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
<urn:regesta:record:25230> a crm:E31_Document .
<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-W000058:community> a crm:E74_Group ; rdfs:label "Augustiner-Chorherrenstift Waldsee/Wallsee" .
<urn:regesta:25230:provisions> crm:P3_has_note "Friedrich beurkundet die Umwandlung der Pfarrkirche in Waldsee/Wallsee in ein Augustiner-Chorherrenstift" .
<urn:regesta:25230:provisions> a crm:E7_Activity ; crm:P2_has_type v:LegalEnactment ; crm:P14_carried_out_by <urn:regesta:actor:RI004-002-F000471> ; crm:P3_has_note "legt mit Zustimmung Bischof Hermanns von Konstanz (†) fest, dass der Propst und dessen Untertanen keinem Archidiakon oder Dekan, sondern nur ihren Bischöfen (= von Konstanz) untertan sein sollen, und bestimmt, dass der Propst die Propstei aus der Hand des Herzogs von Schwaben empfangen soll, die Güter der Kirche nicht entfremden oder verpfänden dürfe und gemeinsam mit dem Herzog von Schwaben das Stift und dessen Güter zu schützen habe" ; crm:P3_has_note "Er unterstellt die Ministerialen von Waldsee/Wallsee ausschließlich dem Herzog von Schwaben und betont abermals, dass der Propst der Kirche deren Güter weder durch Verpfändung noch durch Verlehnung oder Verkauf veräußern darf." .
<urn:regesta:25230:permission> a crm:E7_Activity ; crm:P2_has_type v:LegalEnactment ; crm:P14_carried_out_by <urn:regesta:actor:RI004-002-F000471> ; reg:condition "kinderlosen Ministerialen" ; crm:P3_has_note "ihre Güter dem Konvent zu übertragen" .
<urn:regesta:25230:rights> a crm:E7_Activity ; crm:P2_has_type v:RightGrant ; crm:P14_carried_out_by <urn:regesta:actor:RI004-002-F000471> ; crm:P3_has_note "gewährt die Freiheit der Propstwahl" ; crm:P3_has_note "gewährt den freien Zensualen und Menschen gleich welchen Standes, die zur Herrschaft des Stiftes gehören, das Recht, dass niemand sie nomine beneficii verkaufen dürfe" ; crm:P3_has_note "gesteht den Ministerialen das freie Begräbnisrecht in dieser Kirche zu, wo immer sie sterben mögen" .
<urn:regesta:25230:a1> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:25230:provisions> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:LegalEnactment ; reg:source <urn:regesta:record:25230> ; reg:evidence "legt mit Zustimmung Bischof Hermanns von Konstanz (†) fest, dass der Propst und dessen Untertanen keinem Archidiakon oder Dekan, sondern nur ihren Bischöfen (= von Konstanz) untertan sein sollen, und bestimmt, dass der Propst die Propstei aus der Hand des Herzogs von Schwaben empfangen soll, die Güter der Kirche nicht entfremden oder verpfänden dürfe und gemeinsam mit dem Herzog von Schwaben das Stift und dessen Güter zu schützen habe" .
<urn:regesta:25230:a2> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:25230:permission> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:LegalEnactment ; reg:source <urn:regesta:record:25230> ; reg:evidence "Er erlaubt kinderlosen Ministerialen, ihre Güter dem Konvent zu übertragen" .
<urn:regesta:25230:a3> a crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to <urn:regesta:25230:rights> ; crm:P177_assigned_property_of_type crm:P2_has_type ; crm:P141_assigned v:RightGrant ; reg:source <urn:regesta:record:25230> ; reg:evidence "gewährt den freien Zensualen und Menschen gleich welchen Standes, die zur Herrschaft des Stiftes gehören, das Recht, dass niemand sie nomine beneficii verkaufen dürfe, und gesteht den Ministerialen das freie Begräbnisrecht in dieser Kirche zu, wo immer sie sterben mögen" .
