# Earlier act: the foundation by the ancestors. The contract has no foundation type;
# rv:Donation is the closest act type and is reported as a model gap. No date.
<urn:regesta:22783:stiftung> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22783> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "von seinen Vorfahren, Bischof Otto von Straßburg, Herzog Friedrich (I.) von Schwaben, Ludwig, Konrad und Walter, gestifteten Kloster St. Fides in Schlettstadt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000410> ; rf:role rv:Grantor ; rf:nameInSource "Bischof Otto von Straßburg" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000680> ; rf:role rv:Grantor ; rf:nameInSource "Herzog Friedrich (I.) von Schwaben" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-L000852> ; rf:role rv:Grantor ; rf:nameInSource "Ludwig" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000461> ; rf:role rv:Grantor ; rf:nameInSource "Konrad" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000125> ; rf:role rv:Grantor ; rf:nameInSource "Walter" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S000362:community> ; rf:role rv:Recipient ; rf:nameInSource "Kloster St. Fides in Schlettstadt" ] ;
    rf:qualifier "gestifteten" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-38> ;
    rf:verificationStatus rv:unchecked .

# Stated kinship: each named founder is called an ancestor (Vorfahr) of Friedrich. One factoid per pair, no chain.
<urn:regesta:22783:vorfahr-otto> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:22783> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich bestätigt dem von seinen Vorfahren, Bischof Otto von Straßburg" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Kin ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000410> ; rf:role rv:Kin ; rf:nameInSource "Bischof Otto von Straßburg" ] ;
    rf:qualifier "Vorfahren" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-38> ;
    rf:verificationStatus rv:unchecked .

