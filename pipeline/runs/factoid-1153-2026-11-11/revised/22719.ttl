<urn:regesta:record:22719> a crm:E31_Document .

<urn:regesta:actor:RI004-002-L000841> a crm:E21_Person ;
    rdfs:label "Landgraf (Ludwig II. von Thüringen)" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "König (Friedrich)" .

<urn:regesta:22719:gut> a crm:E18_Physical_Thing ;
    rdfs:label "ein Gut" .

# Earlier request, reported as having happened before this letter; no date is implied.
<urn:regesta:22719:earlier-request> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22719> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "um das er sich schon neulich bei ihm bemüht hat" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-L000841> ; rf:role rv:Petitioner ; rf:nameInSource "er" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Addressee ; rf:nameInSource "ihm" ] ;
    rf:concerns <urn:regesta:22719:gut> ;
    rf:qualifier "schon neulich" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-23> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22719:request> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22719> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Landgraf (Ludwig II. von Thüringen) dankt König (Friedrich)" ] ,
                [ a oa:TextQuoteSelector ; oa:exact "bittet um ein Gut" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-L000841> ; rf:role rv:Petitioner ; rf:nameInSource "Landgraf (Ludwig II. von Thüringen)" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Addressee ; rf:nameInSource "König (Friedrich)" ] ;
    rf:concerns <urn:regesta:22719:gut> ;
    rf:refersToAct <urn:regesta:22719:earlier-request> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-23> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22719:assurance> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22719> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "sagt, nachdem er genug über den Böhmenherzog gehört hat, sein Erscheinen auf dem Hoftag und seine volle Unterstützung zu" ] ,
                [ a oa:TextQuoteSelector ; oa:exact "Landgraf (Ludwig II. von Thüringen) dankt König (Friedrich)" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-L000841> ; rf:role rv:Grantor ; rf:nameInSource "Landgraf (Ludwig II. von Thüringen)" ] ,
                 [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Beneficiary ; rf:nameInSource "König (Friedrich)" ] ;
    rf:qualifier "nachdem er genug über den Böhmenherzog gehört hat" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-23> ;
    rf:verificationStatus rv:unchecked .
