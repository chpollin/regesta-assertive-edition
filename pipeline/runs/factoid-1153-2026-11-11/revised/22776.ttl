<urn:regesta:record:22776> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-H001017> a crm:E21_Person ;
    rdfs:label "Erzbischof Hillin von Trier" .

<urn:regesta:actor:RI004-002-R000500> a crm:E21_Person ;
    rdfs:label "Abt (Rether) von Prüm" .

# Request: the ruler demands that the archbishop consecrate the newly elected abbot.
<urn:regesta:22776:request-consecration> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22776> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich fordert Erzbischof Hillin von Trier abermals auf, dem neugewählten Abt (Rether) von Prüm , der zu Unrecht der Simonie verdächtigt wurde, unverzüglich die Weihe zu erteilen" ] ;
    rf:reference <urn:regesta:22776:request-consecration:ref-friedrich> ,
        <urn:regesta:22776:request-consecration:ref-hillin> ,
        <urn:regesta:22776:request-consecration:ref-rether> ;
    rf:qualifier "abermals" , "unverzüglich" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-37> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22776:request-consecration:ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Petitioner ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22776:request-consecration:ref-hillin> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-H001017> ;
    rf:role rv:Addressee ;
    rf:nameInSource "Erzbischof Hillin von Trier" .

<urn:regesta:22776:request-consecration:ref-rether> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-R000500> ;
    rf:role rv:Beneficiary ;
    rf:nameInSource "Abt (Rether) von Prüm" .
