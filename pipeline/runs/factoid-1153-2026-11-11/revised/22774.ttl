    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22774> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "erklärt sich als zuständig für Klagen des Klosters gegen den Vogt" ] ;
