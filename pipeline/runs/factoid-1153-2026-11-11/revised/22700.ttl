<urn:regesta:22700:election> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22700> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die nach dem Tode König Konrads (III.) erfolgte Wahl Herzog Friedrichs von Schwaben zu dessen Nachfolger" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Recipient ; rf:nameInSource "Herzog Friedrichs von Schwaben" ] ;
