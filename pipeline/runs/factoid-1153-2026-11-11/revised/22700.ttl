    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g4> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22700:advice-declare-king> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22700> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "rät ihm, Friedrich zum König und Verteidiger der Kirche zu erklären" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "(Wibald ) schreibt an Papst Eugen (III.)" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000420> ; rf:role rv:Participant ; rf:nameInSource "Wibald" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Addressee ; rf:nameInSource "ihm" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Beneficiary ; rf:nameInSource "Friedrich" ] ;
    rf:qualifier "rät" ;
    rf:partOf <urn:regesta:22700:communication> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .
