<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Herzog Friedrichs von Schwaben" .

<urn:regesta:22700:communication> a rf:ActFactoid ;
    rf:factoidType rv:Communication ;
    rf:source <urn:regesta:record:22700> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "(Wibald ) schreibt an Papst Eugen (III.)" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000420> ; rf:role rv:Participant ; rf:nameInSource "Wibald" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Addressee ; rf:nameInSource "Papst Eugen (III.)" ] ;
