    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "der Streit zwischen Eufemia, der Witwe Heinrichs von Hegilen, und dem Stift Berchtesgaden unter Propst Heinrich um Saline und Salzpfanne zu Reichenhall" ] ;
