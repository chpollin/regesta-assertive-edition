        rf:role rv:Witness ;
        rf:nameInSource "Otto von Moos" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-E000440> ;
        rf:role rv:Witness ;
        rf:nameInSource "Erbo von Biburg" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-H000788> ;
        rf:role rv:Witness ;
        rf:nameInSource "Herbord von Hebingen" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Participant ;
        rf:nameInSource "König Friedrich" ] ;
    rf:concerns <urn:regesta:135064:saline-salzpfanne> ;
    rf:ground "nach dem Zeugnis der Edelfreien Otto von Moos, Erbo von Biburg und Herbord von Hebingen" ;
    rf:qualifier "zugunsten des Stiftes" , "erwählten Richters" ;
