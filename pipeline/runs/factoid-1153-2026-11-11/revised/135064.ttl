<urn:regesta:135064:judgment> a rf:ActFactoid ;
    rf:factoidType rv:Judgment ;
    rf:source <urn:regesta:record:135064> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "durch Spruch des erwählten Richters Markgraf Engelbert von Kraiburg (Istrien) zugunsten des Stiftes entschieden" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "nach dem Zeugnis der Edelfreien Otto von Moos, Erbo von Biburg und Herbord von Hebingen" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "Vor König Friedrich (coram rege Friderico)" ] ;
    rf:refersToAct <urn:regesta:135064:dispute> ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-E000342> ;
        rf:role rv:Judge ;
        rf:nameInSource "Markgraf Engelbert von Kraiburg" ] ,
