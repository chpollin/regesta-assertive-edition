<urn:regesta:22811:uebertragung> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22811> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich überträgt dem Erzbischof Hugo , dem Domdekan Wilhelm sowie deren Nachfolgern und dem Domkapitel von Vienne die Burg Pipet (Popetum), das Palais des Canaux (Candles), die Pfalz und die custodia der ausschließlich dem Reich unterstehenden Stadt Vienne während seiner Abwesenheit" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001273> ; rf:role rv:Recipient ; rf:nameInSource "Erzbischof Hugo" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000540> ; rf:role rv:Recipient ; rf:nameInSource "Domdekan Wilhelm" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22811:local:nachfolger> ; rf:role rv:Recipient ; rf:nameInSource "deren Nachfolgern" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-V000394:community> ; rf:role rv:Recipient ; rf:nameInSource "Domkapitel von Vienne" ] ;
    rf:concerns <urn:regesta:22811:burg-pipet> , <urn:regesta:22811:palais-des-canaux> , <urn:regesta:22811:pfalz> , <urn:regesta:22811:custodia> , <urn:regesta:22811:stadt-vienne> ;
    rf:qualifier "während seiner Abwesenheit" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-45> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22811:ausschluss-laien> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22811> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "schließt alle Laien von der Stadtherrschaft aus" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich überträgt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ;
    rf:concerns <urn:regesta:22811:stadtherrschaft> , <urn:regesta:22811:stadt-vienne> ;
    rf:partOf <urn:regesta:22811:uebertragung> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-45> ;
    rf:verificationStatus rv:unchecked .
