<urn:regesta:22691:election> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22691> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich wird gemäß dem Reichsrecht" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "in Anwesenheit einer großen Zahl von Fürsten, auch aus Italien, unter Zustimmung aller zum König gewählt" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "Die Erzbischöfe Arnold II. von Köln und Hillin von Trier treten besonders für ihn ein." ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:22691:local:fuersten> ;
        rf:role rv:Participant ;
        rf:nameInSource "einer großen Zahl von Fürsten, auch aus Italien" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-A001202> ;
        rf:role rv:Participant ;
        rf:nameInSource "Arnold II. von Köln" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-H001017> ;
        rf:role rv:Participant ;
        rf:nameInSource "Hillin von Trier" ] ;
    rf:qualifier "zum König gewählt" , "gemäß dem Reichsrecht" , "unter Zustimmung aller" ;
    rf:ground "Als Grund für diese Wahl nennt Otto von Freising die Verwandtschaft Friedrichs mit Staufern und Welfen" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g4> ;
    rf:verificationStatus rv:unchecked .

