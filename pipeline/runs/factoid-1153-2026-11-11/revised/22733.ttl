@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22733> a crm:E31_Document .

# Actors

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:22733:local:stadt-augsburg> a crm:E74_Group ;
    rdfs:label "Stadt Augsburg" .

<urn:regesta:actor:RI004-002-K000322> a crm:E21_Person ;
    rdfs:label "Bischofs Konrad" .

<urn:regesta:actor:22733:local:geistliche> a crm:E74_Group ;
    rdfs:label "der Geistlichen" .

<urn:regesta:actor:22733:local:stadtbewohner> a crm:E74_Group ;
    rdfs:label "aller Stadtbewohner" .

<urn:regesta:actor:RI004-002-A001455:community> a crm:E74_Group ;
    rdfs:label "Vögte" .

<urn:regesta:actor:RI004-002-A001444:community> a crm:E74_Group ;
    rdfs:label "Domkanonikern" .

<urn:regesta:actor:RI004-002-A000287> a crm:E21_Person ;
    rdfs:label "Vogtes Adelgoz" .

<urn:regesta:actor:RI004-002-K000431> a crm:E21_Person ;
