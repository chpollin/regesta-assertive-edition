# Rights

<urn:regesta:22733:stadtrechte> a crm:E30_Right ;
    crm:P2_has_type rv:LordshipRights ;
    rdfs:label "Stadtrechte" .

# Complaints that prompted the act

<urn:regesta:22733:complaint> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22733> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "auf Klagen des Bischofs Konrad, der Geistlichen und aller Stadtbewohner über Gewalttätigkeiten der Vögte und über das Fehlen eines festgelegten Rechtes" ] ;
    rf:reference <urn:regesta:22733:ref-complaint-konrad> ,
        <urn:regesta:22733:ref-complaint-geistliche> ,
        <urn:regesta:22733:ref-complaint-stadtbewohner> ,
        <urn:regesta:22733:ref-complaint-voegte> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-26> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22733:ref-complaint-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000322> ;
    rf:role rv:Claimant ;
    rf:nameInSource "Bischofs Konrad" .

<urn:regesta:22733:ref-complaint-geistliche> a rf:Reference ;
    rf:actor <urn:regesta:actor:22733:local:geistliche> ;
    rf:role rv:Claimant ;
    rf:nameInSource "der Geistlichen" .

<urn:regesta:22733:ref-complaint-stadtbewohner> a rf:Reference ;
    rf:actor <urn:regesta:actor:22733:local:stadtbewohner> ;
    rf:role rv:Claimant ;
    rf:nameInSource "aller Stadtbewohner" .

<urn:regesta:22733:ref-complaint-voegte> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-A001455:community> ;
    rf:role rv:Respondent ;
    rf:nameInSource "der Vögte" .

# Main act: confirmation of the Weistum

<urn:regesta:22733:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22733> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich bestätigt der Stadt Augsburg auf Klagen des Bischofs Konrad, der Geistlichen und aller Stadtbewohner" ] ,
        [ a oa:TextQuoteSelector ;
        oa:exact "ein Weistum über die Stadtrechte" ] ;
    rf:reference <urn:regesta:22733:ref-conf-friedrich> ,
        <urn:regesta:22733:ref-conf-augsburg> ,
        <urn:regesta:22733:ref-conf-konrad> ,
        <urn:regesta:22733:ref-conf-geistliche> ,
        <urn:regesta:22733:ref-conf-stadtbewohner> ;
    rf:concerns <urn:regesta:22733:stadtrechte> ;
    rf:ground "über Gewalttätigkeiten der Vögte und über das Fehlen eines festgelegten Rechtes" ;
    rf:refersToAct <urn:regesta:22733:proclamation> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g6> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22733:ref-conf-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22733:ref-conf-augsburg> a rf:Reference ;
    rf:actor <urn:regesta:actor:22733:local:stadt-augsburg> ;
    rf:role rv:Recipient ;
    rf:nameInSource "Stadt Augsburg" .

<urn:regesta:22733:ref-conf-konrad> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000322> ;
    rf:role rv:Petitioner ;
    rf:nameInSource "Bischofs Konrad" .

<urn:regesta:22733:ref-conf-geistliche> a rf:Reference ;
    rf:actor <urn:regesta:actor:22733:local:geistliche> ;
    rf:role rv:Petitioner ;
    rf:nameInSource "der Geistlichen" .

<urn:regesta:22733:ref-conf-stadtbewohner> a rf:Reference ;
    rf:actor <urn:regesta:actor:22733:local:stadtbewohner> ;
    rf:role rv:Petitioner ;
    rf:nameInSource "aller Stadtbewohner" .

# Earlier act: the law fixed at the Regensburg court diet

<urn:regesta:22733:regensburg-law> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22733> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "das auf dem Regensburger Hoftag (unter Heinrich IV.) festgelegte Recht" ] ,
        [ a oa:TextQuoteSelector ;
        oa:exact "Abgrenzung der Rechte zwischen den Vögten und den Domkanonikern" ] ;
    rf:reference <urn:regesta:22733:ref-law-heinrich> ,
        <urn:regesta:22733:ref-law-voegte> ,
        <urn:regesta:22733:ref-law-domkanoniker> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-26> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22733:ref-law-heinrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:22733:local:heinrich-iv> ;
    rf:role rv:Participant ;
    rf:nameInSource "Heinrich IV." .

<urn:regesta:22733:ref-law-voegte> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-A001455:community> ;
    rf:role rv:Participant ;
    rf:nameInSource "Vögten" .

<urn:regesta:22733:ref-law-domkanoniker> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-A001444:community> ;
    rf:role rv:Participant ;
    rf:nameInSource "Domkanonikern" .

# Proclamation and reaffirmation of that law, the Weistum the confirmation refers to

<urn:regesta:22733:proclamation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22733> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "ohne Hinzufügung von Neuerungen wird in Gegenwart des Vogtes Adelgoz und des Burggrafen Konrad das auf dem Regensburger Hoftag (unter Heinrich IV.) festgelegte Recht verkündet und bekräftigt" ] ;
    rf:reference <urn:regesta:22733:ref-proc-adelgoz> ,
        <urn:regesta:22733:ref-proc-burggraf> ;
    rf:qualifier "ohne Hinzufügung von Neuerungen" ;
    rf:refersToAct <urn:regesta:22733:regensburg-law> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g6> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22733:ref-proc-adelgoz> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-A000287> ;
    rf:role rv:Participant ;
    rf:nameInSource "Vogtes Adelgoz" .

<urn:regesta:22733:ref-proc-burggraf> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-K000431> ;
    rf:role rv:Participant ;
    rf:nameInSource "Burggrafen Konrad" .
