<urn:regesta:22752:p6-kleriker> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die Maßnahmen bei Friedensbruch durch Kleriker [§6]" ] ;
    rf:partOf <urn:regesta:22752:landfrieden> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-31> ;
