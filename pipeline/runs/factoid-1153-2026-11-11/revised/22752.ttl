<urn:regesta:22752:p7-burgherrn> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die Maßregeln für Burgherrn, auf deren Burg sich der Beklagte geflüchtet hat [§7]" ] ;
