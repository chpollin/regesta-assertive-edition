<urn:regesta:22752:p2-flucht-gueter> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die Maßnahmen bei Flucht von Friedensbrechern hinsichtlich ihrer Güter [§2]" ] ;
