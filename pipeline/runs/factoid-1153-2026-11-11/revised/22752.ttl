<urn:regesta:22752:p8-10-19-verfahren> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "ordnet das Verfahren bei Anklagen auf Friedensbruch zwischen Bauern und Rittern, Rittern und Bauern oder unter Rittern [§10], bei Streitigkeiten von zwei oder mehr Leuten um ein Lehen [§8 und 9] oder zwischen Ministerialen eines Herrn [§19]" ] ;
    rf:partOf <urn:regesta:22752:landfrieden> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-31> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22752:p12-13-15-waffentragen> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "spricht das Verbot bzw. die Erlaubnis zum Waffentragen für Bauern, Kaufleute und Ritter [§12, 13 und 15] aus" ] ;
    rf:partOf <urn:regesta:22752:landfrieden> ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:22752:local:bauern> ; rf:role rv:Participant ; rf:nameInSource "Bauern" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22752:local:kaufleute> ; rf:role rv:Participant ; rf:nameInSource "Kaufleute" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22752:local:ritter> ; rf:role rv:Participant ; rf:nameInSource "Ritter" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-31> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22752:p17-lehensamt> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "erklärt Leute, die ein ihnen wegen schlechter Verwaltung abgesprochenes Lehensamt gewaltsam wiederzuerlangen trachten, als Friedensbrecher [§17]" ] ;
    rf:partOf <urn:regesta:22752:landfrieden> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-31> ;
    rf:verificationStatus rv:unchecked .

