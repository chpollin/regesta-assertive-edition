<urn:regesta:22752:landfrieden> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich verkündet einen in allen Teilen des Reiches gültigen Landfrieden" ] ;
