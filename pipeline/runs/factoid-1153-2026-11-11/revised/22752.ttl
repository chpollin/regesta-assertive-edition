<urn:regesta:22752:p3-5-koerperverletzung> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "bestimmt die Strafen für schwere [§3] und leichtere Körperverletzung bzw. auch für Schmähreden [§4 und 5]" ] ;
    rf:partOf <urn:regesta:22752:landfrieden> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-31> ;
