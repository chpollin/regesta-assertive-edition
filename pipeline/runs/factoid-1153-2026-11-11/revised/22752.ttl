<urn:regesta:22752:p20-weide-wald> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22752> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die Erlaubnis, Weide und Wald unter Hintanhaltung von Verwüstungen und Schäden für die eigenen Bedürfnisse zu verwenden [§20]" ] ;
