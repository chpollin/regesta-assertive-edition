<urn:regesta:22769:donation> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22769> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich schenkt als Seelgerät für seine Eltern und seine königlichen und kaiserlichen Vorfahren, aber auch wegen der treuen Dienste Bischof Gunthers der bischöflichen Kirche von Speyer (in honorem sancte dei genitricis Marię ... Spirensi ecclesię) die Reichsburg Berwartstein" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S000970:community> ; rf:role rv:Recipient ; rf:nameInSource "bischöflichen Kirche von Speyer" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22769:local:eltern> ; rf:role rv:Beneficiary ; rf:nameInSource "seine Eltern" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22769:local:vorfahren> ; rf:role rv:Beneficiary ; rf:nameInSource "seine königlichen und kaiserlichen Vorfahren" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G001306> ; rf:role rv:Participant ; rf:nameInSource "Bischof Gunthers" ] ;
    rf:concerns <urn:regesta:22769:berwartstein> ;
    rf:ground "als Seelgerät für seine Eltern und seine königlichen und kaiserlichen Vorfahren" ,
        "wegen der treuen Dienste Bischof Gunthers" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-35> ;
    rf:verificationStatus rv:unchecked .

