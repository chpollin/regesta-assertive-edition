    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "castrum Berwartstein, quod regno ac nobis attinet" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:22769:local:regnum> ; rf:role rv:Possessor ; rf:nameInSource "regno" ] ,
