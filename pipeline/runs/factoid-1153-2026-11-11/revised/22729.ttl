<urn:regesta:record:22729> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-B000114:community> a crm:E74_Group ;
    rdfs:label "Kirche von Bamberg" .

<urn:regesta:actor:22729:local:vorgaenger> a rf:FunctionalActor ;
