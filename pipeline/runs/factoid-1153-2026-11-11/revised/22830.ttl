@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22830> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 203" .

<urn:regesta:actor:RI004-002-A000002> a crm:E21_Person ;
    rdfs:label "A." .

<urn:regesta:actor:RI004-002-W000420> a crm:E21_Person ;
    rdfs:label "Abt Wibald von Stablo" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "des Königs" .

<urn:regesta:22830:gift> a crm:E18_Physical_Thing ;
    rdfs:label "das Geschenk des Königs" .

<urn:regesta:22830:request> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:source <urn:regesta:record:22830> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "A. bittet Abt Wibald von Stablo , daß er ihm, wenn es möglich ist, das Geschenk des Königs zukommen lasse" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-A000002> ;
        rf:role rv:Petitioner ;
        rf:nameInSource "A." ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-W000420> ;
        rf:role rv:Addressee ;
        rf:nameInSource "Abt Wibald von Stablo" ] ;
    rf:concerns <urn:regesta:22830:gift> ;
    rf:condition "wenn es möglich ist" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-50> ;
    rf:verificationStatus rv:unchecked .

# The earlier gift of the king, which the regest presupposes; its recipient rests on the
# relative clause stating that the gift is withheld from A. No date and no delivery are asserted.
<urn:regesta:22830:royal-gift> a rf:ActFactoid ;
    rf:factoidType rv:Donation ;
    rf:source <urn:regesta:record:22830> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "das Geschenk des Königs" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "das ihm Graf Emicho von Leiningen vorenthält" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "des Königs" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-A000002> ;
        rf:role rv:Recipient ;
        rf:nameInSource "ihm" ] ;
    rf:concerns <urn:regesta:22830:gift> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-50> ;
    rf:verificationStatus rv:unchecked .
