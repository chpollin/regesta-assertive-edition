    rdfs:label "die volle Unterordnung des Klosters Hastière (Hasteriensis) unter die Abtei Waulsort (Walcidorensis)" .

<urn:regesta:22711:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22711> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich bestätigt gemäß den Privilegien seiner Vorgänger, Lothar III. und Konrad III., die volle Unterordnung des Klosters Hastière (Hasteriensis) unter die Abtei Waulsort (Walcidorensis)" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ;
