        rf:role rv:Beneficiary ; rf:nameInSource "Abtei Waulsort (Walcidorensis)" ] ;
    rf:concerns <urn:regesta:22711:right-unterordnung> , <urn:regesta:actor:RI004-002-H000222:community> ;
    rf:refersToAct <urn:regesta:22711:privilege-lothar> , <urn:regesta:22711:privilege-konrad> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-21> ;
    rf:verificationStatus rv:unchecked .

