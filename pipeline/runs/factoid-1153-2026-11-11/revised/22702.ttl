<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ; rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-I000267> a crm:E21_Person ; rdfs:label "Iwain von Gokesforde" .
<urn:regesta:actor:RI004-002-U000334:community> a crm:E74_Group ; rdfs:label "das Kapitel von St. Johann zu Utrecht" .
