<urn:regesta:22702:claim> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22702> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Klage des Iwain von Gokesforde gegen das Kapitel von St. Johann zu Utrecht um den Hof zu Beusichem" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-I000267> ; rf:role rv:Claimant ; rf:nameInSource "Iwain von Gokesforde" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-U000334:community> ; rf:role rv:Respondent ; rf:nameInSource "das Kapitel von St. Johann zu Utrecht" ] ;
