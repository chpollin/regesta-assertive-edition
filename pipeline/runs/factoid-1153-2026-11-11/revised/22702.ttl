<urn:regesta:22702:renewed-judgment> a rf:ActFactoid ;
    rf:factoidType rv:Judgment ;
    rf:source <urn:regesta:record:22702> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Vor Friedrich wird die bereits unter König Konrad III. abschlägig beschiedene Klage des Iwain von Gokesforde gegen das Kapitel von St. Johann zu Utrecht um den Hof zu Beusichem unter dem Vorsitz Bischof Hermanns von Utrecht erneut abgewiesen" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000820> ; rf:role rv:Judge ; rf:nameInSource "Bischof Hermanns von Utrecht" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-I000267> ; rf:role rv:Claimant ; rf:nameInSource "Iwain von Gokesforde" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-U000334:community> ; rf:role rv:Respondent ; rf:nameInSource "das Kapitel von St. Johann zu Utrecht" ] ;
    rf:refersToAct <urn:regesta:22702:claim> , <urn:regesta:22702:earlier-judgment> ;
    rf:concerns <urn:regesta:22702:hof-beusichem> ;
    rf:qualifier "erneut abgewiesen" , "unter dem Vorsitz" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .
