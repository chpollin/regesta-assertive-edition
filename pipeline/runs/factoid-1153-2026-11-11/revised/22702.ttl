<urn:regesta:22702:earlier-judgment> a rf:ActFactoid ;
    rf:factoidType rv:Judgment ;
    rf:source <urn:regesta:record:22702> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die bereits unter König Konrad III. abschlägig beschiedene Klage des Iwain von Gokesforde" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22702:local:koenig-konrad-iii> ; rf:role rv:Participant ; rf:nameInSource "König Konrad III." ] ,
