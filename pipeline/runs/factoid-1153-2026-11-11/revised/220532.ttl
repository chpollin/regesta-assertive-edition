@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:220532> a crm:E31_Document .

<urn:regesta:actor:RI004-002-W000272> a crm:E21_Person ;
    rdfs:label "Herzog Welf (VI.)" .

<urn:regesta:actor:RI004-002-G001188> a crm:E21_Person ;
    rdfs:label "Guido (III.) Guerra, Graf von Tuszien" .

<urn:regesta:220532:letter> a rf:ActFactoid ;
    rf:factoidType rv:Communication ;
    rf:source <urn:regesta:record:220532> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Herzog Welf (VI.) teilt Guido (III.) Guerra, Graf von Tuszien, mit" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000272> ;
        rf:role rv:Grantor ; rf:nameInSource "Herzog Welf (VI.)" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G001188> ;
        rf:role rv:Addressee ; rf:nameInSource "Guido (III.) Guerra" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g11> ;
    rf:verificationStatus rv:unchecked .

# The vocabulary has no intercession type and no role for the person interceded with, so the
# emperor gets no reference and the intercession stays in exact wording as qualifier.
# The announced coming with troops and the support against enemies are military and out of scope.
<urn:regesta:220532:assurance-intercession> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:partOf <urn:regesta:220532:letter> ;
    rf:source <urn:regesta:record:220532> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "dass er sich beim Kaiser für ihn einsetzen werde" ] ,
      [ a oa:TextQuoteSelector ;
        oa:exact "Herzog Welf (VI.) teilt Guido (III.) Guerra, Graf von Tuszien, mit" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000272> ;
        rf:role rv:Grantor ; rf:nameInSource "Herzog Welf (VI.)" ] ,
      [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-G001188> ;
        rf:role rv:Beneficiary ; rf:nameInSource "Guido (III.) Guerra" ] ;
    rf:qualifier "sich beim Kaiser für ihn einsetzen werde" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:correction-g11> ;
    rf:verificationStatus rv:unchecked .
