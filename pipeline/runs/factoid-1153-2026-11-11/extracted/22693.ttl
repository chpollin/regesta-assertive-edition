<urn:regesta:22693:coronation> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22693> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich wird am Sonntag Letare Jerusalem (März 9) in der Marienkirche von Erzbischof Arnold von Köln unter Mitwirkung anderer Bischöfe nach Ablegung des herkömmlichen Krönungseides unter Akklamation des Volkes gesalbt, gekrönt und auf den Thron Karls des Großen gesetzt" ] ;
    rf:qualifier "gesalbt, gekrönt und auf den Thron Karls des Großen gesetzt" ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Recipient ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A001202> ; rf:role rv:Grantor ; rf:nameInSource "Erzbischof Arnold von Köln" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22693:local:andere-bischoefe> ; rf:role rv:Participant ; rf:nameInSource "anderer Bischöfe" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22693:local:volk> ; rf:role rv:Participant ; rf:nameInSource "des Volkes" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-17> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22693:consecration-muenster> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22693> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Am selben Tag wird von denselben Bischöfen auch der neue Bischof von Münster, der ebenfalls Friedrich heißt, geweiht" ] ;
    rf:qualifier "geweiht" ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000657> ; rf:role rv:Recipient ; rf:nameInSource "der neue Bischof von Münster, der ebenfalls Friedrich heißt" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22693:local:dieselben-bischoefe> ; rf:role rv:Grantor ; rf:nameInSource "denselben Bischöfen" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-17> ;
    rf:verificationStatus rv:unchecked .
