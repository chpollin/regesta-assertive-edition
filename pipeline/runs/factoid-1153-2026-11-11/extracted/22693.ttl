<urn:regesta:actor:RI004-002-F000657> a crm:E21_Person ;
    rdfs:label "der neue Bischof von Münster, der ebenfalls Friedrich heißt" .

<urn:regesta:actor:22693:local:dieselben-bischoefe> a crm:E74_Group ;
