@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22737> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 110" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:22737:local:fuersten> a crm:E74_Group ;
    rdfs:label "Fürsten" .

<urn:regesta:actor:22737:local:laienfuersten> a crm:E74_Group ;
    rdfs:label "Laienfürsten" .

<urn:regesta:22737:peace> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22737> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich hält einen Hoftag und errichtet unter Zustimmung der Fürsten einen festen Frieden" ] ;
    rf:reference <urn:regesta:22737:peace-ref-friedrich> , <urn:regesta:22737:peace-ref-fuersten> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-27> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22737:peace-ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22737:peace-ref-fuersten> a rf:Reference ;
    rf:actor <urn:regesta:actor:22737:local:fuersten> ;
    rf:role rv:Participant ;
    rf:nameInSource "Fürsten" .

<urn:regesta:22737:resolution> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22737> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Die Laienfürsten beschließen, daß bei der Bestrafung von Raub und Brandstiftung an kirchlichen Gütern der weltliche Rechtsspruch der Exkommunikation vorauszugehen habe." ] ;
    rf:reference <urn:regesta:22737:resolution-ref-laienfuersten> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-27> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22737:resolution-ref-laienfuersten> a rf:Reference ;
    rf:actor <urn:regesta:actor:22737:local:laienfuersten> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Laienfürsten" .
