@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22781> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Kaiser (!) Friedrichs" .

<urn:regesta:actor:RI004-002-S001143> a crm:E21_Person ;
    rdfs:label "Bischof Stephan von Metz" .

# Acquisition of the castle. The regest names no transferring party; rv:Grant is the closest
# act type and is reported as a model gap. The usurpation by Herzog Matthäus is not encoded,
# because the contract has no act or state type for a wrongful seizure.
<urn:regesta:22781:erwerb-homburg> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22781> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Bischof Stephan von Metz erwirbt mit Hilfe Kaiser (!) Friedrichs die Burg Homburg" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-S001143> ; rf:role rv:Recipient ; rf:nameInSource "Bischof Stephan von Metz" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "Kaiser (!) Friedrichs" ] ;
    rf:qualifier "erwirbt" , "mit Hilfe" ;
    rf:concerns <urn:regesta:22781:burg-homburg> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-38> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22781:burg-homburg> a crm:E18_Physical_Thing ;
    rdfs:label "die Burg Homburg" .
