<urn:regesta:22861:befehl-keine-untervoegte> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22861> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich befiehlt dem Grafen Heinrich von Namur" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "daselbst keine Untervögte zu dulden" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000540> ; rf:role rv:Addressee ; rf:nameInSource "Grafen Heinrich von Namur" ] ;
    rf:concerns <urn:regesta:22861:vogtei> , <urn:regesta:22861:wasseiges> , <urn:regesta:22861:evrehailles> ;
    rf:ground "auf Grund der Berichte der Mönche und der Einsicht in die älteren Privilegien seiner Vorgänger" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-51> ;
    rf:verificationStatus rv:unchecked .

