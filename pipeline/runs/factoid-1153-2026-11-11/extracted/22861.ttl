    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Heinrich von Namur , der die Vogtei über die Güter des Klosters St. Laurentius zu Lüttich in Wasseiges (Wasegga) und Evrehailles (Eurehalia) aus der Hand des Königs innehat" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H000540> ; rf:role rv:RightHolder ; rf:nameInSource "Heinrich von Namur" ] ;
