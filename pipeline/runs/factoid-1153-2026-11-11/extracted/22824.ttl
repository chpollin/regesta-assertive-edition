<urn:regesta:22824:designation-successor> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22824> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "König Konrads III., der ihn zu seinem Nachfolger erklärt hat" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-K000316> ; rf:role rv:Grantor ; rf:nameInSource "König Konrads III." ] ,
