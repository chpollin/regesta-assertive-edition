<urn:regesta:22824:kinship-konrad> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:22824> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "seines Oheims, König Konrads III." ] ,
