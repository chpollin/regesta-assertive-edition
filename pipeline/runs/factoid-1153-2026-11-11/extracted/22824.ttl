<urn:regesta:22824:assurance-relations> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22824> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "versichert ihn gemäß dem Rat seines Oheims, König Konrads III., der ihn zu seinem Nachfolger erklärt hat, seines Willens zu guten gegenseitigen Beziehungen, die er durch seine Heirat mit einer Verwandten Manuels befestigen will" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich dankt dem oströmischen Kaiser Manuel" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000374> ; rf:role rv:Addressee ; rf:nameInSource "oströmischen Kaiser Manuel" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22824:local:verwandte-manuels> ; rf:role rv:Participant ; rf:nameInSource "einer Verwandten Manuels" ] ;
    rf:ground "gemäß dem Rat seines Oheims, König Konrads III." ;
    rf:qualifier "befestigen will" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-48> ;
    rf:verificationStatus rv:unchecked .

