@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22726> a crm:E31_Document .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-U000146> a crm:E21_Person ;
    rdfs:label "Abtes Ulrich" .

<urn:regesta:actor:RI004-002-M001014:community> a crm:E74_Group ;
    rdfs:label "Kloster Moggio" .

<urn:regesta:22726:thing:besitzstand> a crm:E18_Physical_Thing ;
    rdfs:label "Besitzstand" .

# The confirmed right to accept donations of allodial goods has no fitting concept in
# rv:RightTypes; it is not typed as crm:E30_Right and stays in the evidence (model gap).
# "nach dem Beispiel seiner Vorgänger" refers to precedent only; no earlier act is created and
# the referent of "seiner" is left to the wording.
<urn:regesta:22726:confirmation> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:qualifier "nach dem Beispiel seiner Vorgänger" ;
    rf:source <urn:regesta:record:22726> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich bestätigt auf Bitten des Abtes Ulrich dessen Kloster Moggio (Mosacensis) nach dem Beispiel seiner Vorgänger den Besitzstand und das Recht, Schenkungen von Allodialgütern anzunehmen" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-M001014:community> ;
        rf:role rv:Recipient ;
        rf:nameInSource "Kloster Moggio" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-U000146> ;
        rf:role rv:Petitioner ;
        rf:nameInSource "Abtes Ulrich" ] ;
    rf:concerns <urn:regesta:22726:thing:besitzstand> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-24> ;
    rf:verificationStatus rv:unchecked .
