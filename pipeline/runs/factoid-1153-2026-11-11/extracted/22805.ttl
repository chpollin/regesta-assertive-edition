@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22805> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 178" .

# Dispute: the claim of Heinrich of Saxony for the duchy of Bavaria. The respondent's refusal
# to negotiate has no act type of its own and is kept only in the evidence (model gap).
<urn:regesta:22805:klage-herzogtum-bayern> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22805> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Herzog Heinrich von Bayern weigert sich, über die Klage des gleichfalls anwesenden Herzogs Heinrich von Sachsen um das Herzogtum Bayern zu verhandeln" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-44> ;
    rf:verificationStatus rv:unchecked ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-H000470> ;
        rf:role rv:Claimant ;
        rf:nameInSource "Herzogs Heinrich von Sachsen" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-H000498> ;
        rf:role rv:Respondent ;
        rf:nameInSource "Herzog Heinrich von Bayern" ] ;
    rf:concerns <urn:regesta:22805:herzogtum-bayern> .

<urn:regesta:22805:herzogtum-bayern> a crm:E53_Place ;
    rdfs:label "Herzogtum Bayern" .

# Election of the chancellor Arnold as successor in Mainz, caused by Friedrich.
<urn:regesta:22805:wahl-arnold-mainz> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22805> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "seinen Kanzler Arnold durch anwesende Mitglieder des Klerus und des Volkes zu Heinrichs Nachfolger in Mainz wählen" ] ,
      [ a oa:TextQuoteSelector ; oa:exact "Friedrich läßt Erzbischof Heinrich von Mainz" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-44> ;
    rf:verificationStatus rv:unchecked ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-A001203> ;
        rf:role rv:Recipient ;
        rf:nameInSource "seinen Kanzler Arnold" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:22805:local:mitglieder-klerus-volk> ;
        rf:role rv:Participant ;
        rf:nameInSource "anwesende Mitglieder des Klerus und des Volkes" ] ;
    rf:qualifier "zu Heinrichs Nachfolger in Mainz" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .
<urn:regesta:actor:RI004-002-H000470> a crm:E21_Person ;
    rdfs:label "Herzogs Heinrich von Sachsen" .
<urn:regesta:actor:RI004-002-H000498> a crm:E21_Person ;
    rdfs:label "Herzog Heinrich von Bayern" .
<urn:regesta:actor:RI004-002-A001203> a crm:E21_Person ;
    rdfs:label "Kanzler Arnold" .
<urn:regesta:actor:22805:local:mitglieder-klerus-volk> a crm:E74_Group ;
    rdfs:label "anwesende Mitglieder des Klerus und des Volkes" .
