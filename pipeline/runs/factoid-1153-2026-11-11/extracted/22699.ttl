<urn:regesta:actor:RI004-002-E000589> a crm:E21_Person ; rdfs:label "Papst Eugen (III.)" .
<urn:regesta:actor:RI004-002-E000011> a crm:E21_Person ; rdfs:label "Bischof E(berhard) von Bamberg" .
<urn:regesta:actor:RI004-002-H001017> a crm:E21_Person ; rdfs:label "Elekt H(illin) von Trier" .
<urn:regesta:actor:RI004-002-A000294> a crm:E21_Person ; rdfs:label "Abt A(dam) von Ebrach" .
<urn:regesta:actor:22699:local:fuersten> a crm:E74_Group ; rdfs:label "die Fürsten" .
<urn:regesta:actor:22699:local:roemische-kirche> a crm:E74_Group ; rdfs:label "die römische Kirche" .
