    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22699> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "die katholische Kirche in ihren Privilegien zu schützen" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Er verspricht ihm" ] ;
    rf:reference
