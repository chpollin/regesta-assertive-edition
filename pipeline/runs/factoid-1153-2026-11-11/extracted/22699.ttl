<urn:regesta:22699:frankfurt> a crm:E53_Place ; rdfs:label "Frankfurt" .

<urn:regesta:22699:communication> a rf:ActFactoid ;
    rf:factoidType rv:Communication ;
    rf:source <urn:regesta:record:22699> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich unterrichtet Papst Eugen (III.) nach der Sitte seiner Vorgänger durch seine Legaten Bischof E(berhard) von Bamberg, Elekt H(illin) von Trier und Abt A(dam) von Ebrach und dieses Schreiben" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Addressee ; rf:nameInSource "Papst Eugen (III.)" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000011> ; rf:role rv:Envoy ; rf:nameInSource "Bischof E(berhard) von Bamberg" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-H001017> ; rf:role rv:Envoy ; rf:nameInSource "Elekt H(illin) von Trier" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000294> ; rf:role rv:Envoy ; rf:nameInSource "Abt A(dam) von Ebrach" ] ;
    rf:qualifier "nach der Sitte seiner Vorgänger" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22699:election> a rf:ActFactoid ;
    rf:factoidType rv:Appointment ;
    rf:source <urn:regesta:record:22699> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Er zeigt ihm seine am 17. Tag (= 1152 März 4) nach dem Ableben König K(onrads III.) zu Frankfurt in Eintracht erfolgte Wahl durch die Fürsten" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22699:local:fuersten> ; rf:role rv:Grantor ; rf:nameInSource "die Fürsten" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Recipient ; rf:nameInSource "Er" ] ;
    rf:concerns <urn:regesta:22699:frankfurt> ;
    rf:qualifier "in Eintracht" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22699:assurance-roman-church> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22699> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Er verspricht ihm, die römische Kirche nach seinem Krönungseid (iuxta professionis nostrę formulam, quam ab orthodoxis presulibus in ipso regni throno et unctione sacra accepimus) zu schützen" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Er" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Addressee ; rf:nameInSource "ihm" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22699:local:roemische-kirche> ; rf:role rv:Beneficiary ; rf:nameInSource "die römische Kirche" ] ;
    rf:qualifier "nach seinem Krönungseid" ;
    rf:partOf <urn:regesta:22699:communication> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22699:assurance-peace> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:source <urn:regesta:record:22699> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "den Witwen, Waisen und dem ihm anvertrauten Volk den Frieden zu bringen und zu bewahren" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Er verspricht ihm" ] ;
    rf:reference
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Er" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-E000589> ; rf:role rv:Addressee ; rf:nameInSource "ihm" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22699:local:witwen> ; rf:role rv:Beneficiary ; rf:nameInSource "Witwen" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22699:local:waisen> ; rf:role rv:Beneficiary ; rf:nameInSource "Waisen" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22699:local:anvertrautes-volk> ; rf:role rv:Beneficiary ; rf:nameInSource "dem ihm anvertrauten Volk" ] ;
    rf:partOf <urn:regesta:22699:communication> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
    rf:verificationStatus rv:unchecked .

