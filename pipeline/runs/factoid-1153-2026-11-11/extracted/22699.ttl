        [ a rf:Reference ; rf:actor <urn:regesta:actor:22699:local:katholische-kirche> ; rf:role rv:Beneficiary ; rf:nameInSource "die katholische Kirche" ] ;
    rf:partOf <urn:regesta:22699:communication> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-18> ;
