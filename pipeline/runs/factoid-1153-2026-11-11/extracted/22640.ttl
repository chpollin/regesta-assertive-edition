<urn:regesta:22640:parenthood> a rf:StateFactoid ;
    rf:factoidType rv:Parenthood ;
    rf:source <urn:regesta:record:22640> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich gibt gemeinsam mit seinem Vater, Herzog Friedrich (II. von Schwaben)" ] ;
