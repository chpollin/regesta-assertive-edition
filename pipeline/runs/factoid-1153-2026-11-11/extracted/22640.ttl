    rf:nameInSource "Friedrich" .

<urn:regesta:22640:vogtei-ref-father> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000681> ;
    rf:role rv:RightHolder ;
    rf:nameInSource "Herzog Friedrich (II. von Schwaben)" .

# Nearest act type for a consent: the contract has no consent or foundation type (reported as model gap).
# The foundation itself is not recorded as a performed act; it is only the object of the consent.
<urn:regesta:22640:consent> a rf:ActFactoid ;
    rf:factoidType rv:Confirmation ;
    rf:source <urn:regesta:record:22640> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich gibt gemeinsam mit seinem Vater, Herzog Friedrich (II. von Schwaben), als Inhaber der Vogtei über das Kloster Lorch seine Zustimmung zur Errichtung des Frauenstiftes Lochgarten durch die Untertanen von Lorch, Konstantin und Giselbert" ] ;
    rf:reference <urn:regesta:22640:consent-ref-friedrich> , <urn:regesta:22640:consent-ref-father> ,
        <urn:regesta:22640:consent-ref-konstantin> , <urn:regesta:22640:consent-ref-giselbert> ;
    rf:concerns <urn:regesta:actor:RI004-002-L000545:community> ;
    rf:qualifier "Zustimmung" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-4> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22640:consent-ref-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Grantor ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22640:consent-ref-father> a rf:Reference ;
