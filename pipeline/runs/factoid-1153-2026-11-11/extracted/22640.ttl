<urn:regesta:22640:parenthood-ref-child> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Child ;
    rf:nameInSource "Friedrich" .

<urn:regesta:22640:vogtei-holding> a rf:StateFactoid ;
    rf:factoidType rv:RightHolding ;
    rf:source <urn:regesta:record:22640> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich gibt gemeinsam mit seinem Vater, Herzog Friedrich (II. von Schwaben), als Inhaber der Vogtei über das Kloster Lorch" ] ;
    rf:reference <urn:regesta:22640:vogtei-ref-friedrich> , <urn:regesta:22640:vogtei-ref-father> ;
    rf:concerns <urn:regesta:22640:right-vogtei-lorch> , <urn:regesta:actor:RI004-002-L000660:community> ;
