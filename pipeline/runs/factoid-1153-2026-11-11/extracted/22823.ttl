<urn:regesta:22823:mission-manuel> a rf:ActFactoid ;
    rf:factoidType rv:Mission ;
    rf:source <urn:regesta:record:22823> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "sendet er deshalb und wegen eines Vorgehens gegen Sizilien" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Bischof Anselm von Havelberg und Graf Alexander (von Gravina) von Apulien" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "an den oströmischen Kaiser Manuel" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000934> ; rf:role rv:Envoy ; rf:nameInSource "Bischof Anselm von Havelberg" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A000625> ; rf:role rv:Envoy ; rf:nameInSource "Graf Alexander (von Gravina) von Apulien" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-M000374> ; rf:role rv:Addressee ; rf:nameInSource "oströmischen Kaiser Manuel" ] ;
    rf:ground "da er nach seiner erst kürzlich erfolgten Scheidung (Reg. 167) an eine neue Heirat denkt" ,
        "wegen eines Vorgehens gegen Sizilien" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-48> ;
    rf:verificationStatus rv:unchecked .

