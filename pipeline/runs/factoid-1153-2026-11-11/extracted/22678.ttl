@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22678> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. 51" .

# The request records neither the elevation nor the postponement as performed.
# The king, at whom the requested intercession aims, is not an addressee of the letter;
# the vocabulary has no role for the target of an intercession, so he carries no reference.
<urn:regesta:22678:request> a rf:ActFactoid ;
    rf:factoidType rv:Request ;
    rf:qualifier "brieflich" ;
    rf:source <urn:regesta:record:22678> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Landgraf L(udwig II. von Thüringen) bittet Herzog F(riedrich von Schwaben) brieflich, er möge sich beim König für die Erhebung seines Verwandten Gebhard auf den Würzburger Bischofsstuhl einsetzen oder wenigstens eine Verschiebung der Entscheidung bewirken" ] ;
    rf:reference <urn:regesta:22678:ref-request-ludwig> , <urn:regesta:22678:ref-request-friedrich> , <urn:regesta:22678:ref-request-gebhard> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-13> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22678:ref-request-ludwig> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-L000841> ;
    rf:role rv:Petitioner ;
    rf:nameInSource "Landgraf L(udwig II. von Thüringen)" .

<urn:regesta:22678:ref-request-friedrich> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-F000471> ;
    rf:role rv:Addressee ;
    rf:nameInSource "Herzog F(riedrich von Schwaben)" .

<urn:regesta:22678:ref-request-gebhard> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-G000209> ;
    rf:role rv:Beneficiary ;
    rf:nameInSource "Gebhard" .

# Reading: "seines" is taken to refer to Landgraf Ludwig. Grammatically it could also refer to
# Herzog Friedrich, the subject of "er möge"; this is an unresolved reading.
<urn:regesta:22678:kinship-ludwig-gebhard> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:qualifier "Verwandten" ;
    rf:source <urn:regesta:record:22678> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "seines Verwandten Gebhard" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Landgraf L(udwig II. von Thüringen) bittet" ] ;
    rf:reference <urn:regesta:22678:ref-kin-ludwig> , <urn:regesta:22678:ref-kin-gebhard> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-13> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22678:ref-kin-ludwig> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-L000841> ;
    rf:role rv:Kin ;
    rf:nameInSource "seines" .

<urn:regesta:22678:ref-kin-gebhard> a rf:Reference ;
    rf:actor <urn:regesta:actor:RI004-002-G000209> ;
    rf:role rv:Kin ;
    rf:nameInSource "Gebhard" .

<urn:regesta:actor:RI004-002-L000841> a crm:E21_Person ;
    rdfs:label "Landgraf L(udwig II. von Thüringen)" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Herzog F(riedrich von Schwaben)" .

<urn:regesta:actor:RI004-002-G000209> a crm:E21_Person ;
    rdfs:label "Gebhard" .
