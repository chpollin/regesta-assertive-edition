<urn:regesta:22762:kinship-welf> a rf:StateFactoid ;
    rf:factoidType rv:Kinship ;
    rf:source <urn:regesta:record:22762> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich verleiht seinem Oheim, Herzog Welf" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Kin ; rf:nameInSource "Friedrich" ] ,
