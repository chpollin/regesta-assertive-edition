<urn:regesta:22762:hoexter-decision> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22762> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Vor Friedrich und den Fürsten wird gemäß den Klagen Wibalds (vgl. Regg. 119-123) der Wiederaufbau der Befestigungen von Höxter beschlossen" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Participant ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22762:local:fuersten> ; rf:role rv:Participant ; rf:nameInSource "den Fürsten" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000420> ; rf:role rv:Petitioner ; rf:nameInSource "Wibalds" ] ;
    rf:concerns <urn:regesta:22762:befestigungen-hoexter> ;
    rf:ground "gemäß den Klagen Wibalds" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-33> ;
    rf:verificationStatus rv:unchecked .
