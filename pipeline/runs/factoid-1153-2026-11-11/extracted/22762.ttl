<urn:regesta:22762:apulian-complaint> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22762> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "auf die Klage von einigen Apuliern, die von Roger aus ihrer Heimat vertrieben worden sind" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-A001019:community> ; rf:role rv:Claimant ; rf:nameInSource "einigen Apuliern" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-R000806> ; rf:role rv:Respondent ; rf:nameInSource "Roger" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Addressee ; rf:nameInSource "Friedrich" ] ;
    rf:ground "die von Roger aus ihrer Heimat vertrieben worden sind" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-33> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22762:italienzug-oath> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22762> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich läßt auf die Klage von einigen Apuliern, die von Roger aus ihrer Heimat vertrieben worden sind, den Antritt des Italienzuges, der dem Erwerb der Kaiserkrone dienen soll, innerhalb der nächsten zwei Jahre beschwören" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ;
    rf:ground "auf die Klage von einigen Apuliern" ;
    rf:qualifier "innerhalb der nächsten zwei Jahre" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-33> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22762:dispute-heinrich-albrecht> a rf:ActFactoid ;
    rf:factoidType rv:Dispute ;
    rf:source <urn:regesta:record:22762> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "im Streit zwischen Heinrich dem Löwen und Albrecht dem Bären" ] ;
