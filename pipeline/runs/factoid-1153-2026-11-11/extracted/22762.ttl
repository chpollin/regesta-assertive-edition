<urn:regesta:22762:grant-welf> a rf:ActFactoid ;
    rf:factoidType rv:Grant ;
    rf:source <urn:regesta:record:22762> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich verleiht seinem Oheim, Herzog Welf, das Herzogtum Spoleto, die Markgrafschaft Tuszien, den principatus Sardinien und das Hausgut der Gräfin Mathilde" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-W000272> ; rf:role rv:Recipient ; rf:nameInSource "Herzog Welf" ] ;
    rf:concerns <urn:regesta:22762:herzogtum-spoleto> , <urn:regesta:22762:markgrafschaft-tuszien> , <urn:regesta:22762:principatus-sardinien> , <urn:regesta:22762:hausgut-mathilde> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-33> ;
    rf:verificationStatus rv:unchecked .

