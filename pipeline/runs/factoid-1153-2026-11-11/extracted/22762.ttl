    rf:source <urn:regesta:record:22762> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Friedrich erzielt im Streit zwischen Heinrich dem Löwen und Albrecht dem Bären (vgl. Reg. 88) einen Ausgleich" ] ;
