@prefix rf:   <https://example.org/regesta/factoid/> .
@prefix rv:   <https://example.org/regesta/concept/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix oa:   <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:regesta:record:22844> a crm:E31_Document ;
    rdfs:label "RI IV,2,1 n. D217" .

<urn:regesta:actor:RI004-002-F000471> a crm:E21_Person ;
    rdfs:label "Friedrich" .

<urn:regesta:actor:RI004-002-T000382:community> a crm:E74_Group ;
    rdfs:label "die Bewohner von Tortona" .

<urn:regesta:22844:protection-right> a crm:E30_Right ;
    crm:P2_has_type rv:Protection ;
    rdfs:label "seines Schutzes" .

# The letter itself; its delivery is not asserted.
<urn:regesta:22844:letter> a rf:ActFactoid ;
    rf:factoidType rv:Communication ;
    rf:source <urn:regesta:record:22844> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "Friedrich schickt ein Schreiben an die Bewohner von Tortona" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "Friedrich" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-T000382:community> ;
        rf:role rv:Addressee ;
        rf:nameInSource "die Bewohner von Tortona" ] ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-50> ;
    rf:verificationStatus rv:unchecked .

# The assurance of protection the letter contains; it does not establish that protection was exercised.
<urn:regesta:22844:assurance> a rf:ActFactoid ;
    rf:factoidType rv:Assurance ;
    rf:partOf <urn:regesta:22844:letter> ;
    rf:source <urn:regesta:record:22844> ;
    rf:evidence [ a oa:TextQuoteSelector ;
        oa:exact "in dem er sie seines Schutzes (homines, qui erant sub eius tutella et defensione, sicut in litteris suis mandaveraf) versichert" ] ;
    rf:reference [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-F000471> ;
        rf:role rv:Grantor ;
        rf:nameInSource "er" ] ,
      [ a rf:Reference ;
        rf:actor <urn:regesta:actor:RI004-002-T000382:community> ;
        rf:role rv:Recipient ;
        rf:nameInSource "sie" ] ;
    rf:concerns <urn:regesta:22844:protection-right> ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-50> ;
    rf:verificationStatus rv:unchecked .
