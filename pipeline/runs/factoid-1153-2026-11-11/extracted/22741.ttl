    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "auf Eigengut der Edlen Noker, Oudelard, Burchard und Ulrich erbaute und von ihnen dem hl. Petrus übergebene Kloster Beinwil" ] ;
