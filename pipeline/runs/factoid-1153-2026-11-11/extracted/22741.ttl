<urn:regesta:22741:advocacy-succession> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22741> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "daß nach dem Tod des jetzigen Vogtes, Oudelard, dessen nächster Erbe ihm in seinem Amt (officium advocatię) nachfolgen solle, was auch künftig zu beobachten sei" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt das auf Eigengut" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22741:local:naechster-erbe> ; rf:role rv:Beneficiary ; rf:nameInSource "dessen nächster Erbe" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000566> ; rf:role rv:Participant ; rf:nameInSource "Oudelard" ] ;
    rf:concerns <urn:regesta:22741:vogtei> ;
    rf:condition "nach dem Tod des jetzigen Vogtes, Oudelard" ;
    rf:qualifier "was auch künftig zu beobachten sei" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-28> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22741:advocate-court> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22741> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "Schließlich wird festgelegt, daß die Hintersassen des Klosters einmal jährlich mit Zustimmung des Abtes vor das Gericht des Vogtes gerufen werden sollen, der nach den Rechtsgewohnheiten dieser Kirche über ihre Vergehen urteilt" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:22741:local:hintersassen> ; rf:role rv:Participant ; rf:nameInSource "Hintersassen des Klosters" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22741:local:abt> ; rf:role rv:Participant ; rf:nameInSource "des Abtes" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:22741:local:vogt> ; rf:role rv:RightHolder ; rf:nameInSource "des Vogtes" ] ;
    rf:concerns <urn:regesta:22741:vogtgericht> ;
    rf:condition "mit Zustimmung des Abtes" ;
    rf:qualifier "einmal jährlich" , "nach den Rechtsgewohnheiten dieser Kirche" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-28> ;
    rf:verificationStatus rv:unchecked .
