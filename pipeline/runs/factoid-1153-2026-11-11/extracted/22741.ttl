<urn:regesta:22741:single-advocate> a rf:ActFactoid ;
    rf:factoidType rv:Enactment ;
    rf:source <urn:regesta:record:22741> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "verfügt er, daß das Kloster nur einen Vogt haben" ] ,
        [ a oa:TextQuoteSelector ; oa:exact "Friedrich nimmt das auf Eigengut" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-F000471> ; rf:role rv:Grantor ; rf:nameInSource "Friedrich" ] ,
        [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-B000381:community> ; rf:role rv:Beneficiary ; rf:nameInSource "Kloster" ] ;
    rf:concerns <urn:regesta:22741:vogtei> ;
    rf:qualifier "nur einen Vogt" ;
    prov:wasAttributedTo <urn:regesta:agent:factoid-1153-2026-11-11:extraction-batch-28> ;
    rf:verificationStatus rv:unchecked .

<urn:regesta:22741:oudelard-advocate> a rf:StateFactoid ;
    rf:factoidType rv:OfficeHolding ;
    rf:source <urn:regesta:record:22741> ;
    rf:evidence [ a oa:TextQuoteSelector ; oa:exact "des jetzigen Vogtes, Oudelard" ] ;
    rf:reference [ a rf:Reference ; rf:actor <urn:regesta:actor:RI004-002-O000566> ; rf:role rv:Officeholder ; rf:nameInSource "Oudelard" ] ;
